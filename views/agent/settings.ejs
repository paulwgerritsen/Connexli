<%- include('../partials/head') %>
<div class="narrow">
  <a href="/agent" style="font-size:14px;">‹ Back to dashboard</a>
  <h1 style="margin-top:8px;">Account settings</h1>
  <p class="sub">Keep your details current — this is the contact information a homeowner receives if they choose you.</p>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (saved) { %><div class="notice" style="background:#EAF7EE; border:1px solid #BFE5CB; color:#1E6B37; border-radius:10px; padding:12px 16px; margin-bottom:16px; font-size:14.5px;">Your settings have been saved.</div><% } %>

  <form method="POST" action="/agent/settings">
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <div class="card">
      <h2 style="font-size:16px;">Contact information</h2>
      <p class="note" style="margin-top:2px;">Released only to a homeowner who selects your proposal.</p>
      <label for="name">Preferred name</label>
      <input type="text" id="name" name="name" value="<%= p.name %>" required>
      <p class="note" style="margin-top:2px;">This is the name consumers will see on Connexli. Your legal name associated with your real-estate license will remain on file for verification.</p>
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" value="<%= p.email %>" autocomplete="email" required>
      <label for="phone">Phone (optional)</label>
      <input type="tel" id="phone" name="phone" value="<%= p.phone || '' %>" autocomplete="tel">
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Professional details</h2>
      <label for="brokerage">Brokerage</label>
      <input type="text" id="brokerage" name="brokerage" value="<%= p.brokerage %>" required>
      <label for="service_zip">Primary service ZIP code</label>
      <input type="text" id="service_zip" name="service_zip" inputmode="numeric" pattern="\d{5}" value="<%= p.service_zip || '' %>" required>
      <p class="note">We use this to send you opportunities near your area<%= p.service_city ? ' — currently ' + p.service_city + ', ' + (p.service_state || '') : '' %>.</p>
      <div class="sumrow"><span>License number</span><span><%= p.license_number %> (<%= p.license_state || 'UT' %>) · <span class="badge <%= p.status %>"><%= p.status %></span></span></div>
      <% if (p.reld_name) { %><div class="sumrow"><span>License name</span><span><%= p.reld_name %> <span class="hint">(per the licensing registry — kept on file for verification)</span></span></div><% } %>
      <% if (p.verification_status === 'verified') { %>
        <div class="sumrow"><span>License verification</span><span style="color:var(--good); font-weight:600;">✓ Verified<%= p.reld_license_type ? ' · ' + p.reld_license_type : '' %><%= p.reld_expiration ? ' · expires ' + p.reld_expiration : '' %></span></div>
        <% if (p.reld_checked_at) { %><p class="note" style="margin-top:2px;">Last checked <%= new Date(p.reld_checked_at).toLocaleDateString('en-US', { timeZone: 'America/Denver' }) %> against the licensing registry.</p><% } %>
      <% } else if (['failed','expired'].includes(p.verification_status)) { %>
        <div class="sumrow"><span>License verification</span><span style="color:#B42318; font-weight:600;">Issue found — proposal submissions paused</span></div>
        <p class="note" style="margin-top:2px;">We couldn't confirm this license as active. Your account and credits are unaffected; contact <a href="mailto:hello@connexli.com">hello@connexli.com</a> to resolve it.</p>
      <% } %>
      <p class="note">Your license number is part of your verification and can't be edited here. If it changes, contact <a href="mailto:hello@connexli.com">hello@connexli.com</a> so we can re-verify you.</p>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Email notifications</h2>
      <label style="display:flex; gap:10px; align-items:flex-start; cursor:pointer; margin-top:6px;">
        <input type="checkbox" name="email_notifications" <%= p.email_notifications === false ? '' : 'checked' %> style="margin-top:4px; width:16px; height:16px; flex:none; accent-color:var(--blue);">
        <span style="font-size:14px; color:var(--muted); line-height:1.5; font-weight:400;"><b style="color:var(--navy);">Email me about new opportunities</b><br>
        Turning this off only stops the emails — you'll still be matched to every opportunity in your area, see them all on your dashboard, and can submit proposals normally. If a client selects you to connect, that email is always sent.</span>
      </label>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Your track record</h2>
      <p class="note" style="margin-top:2px;">Closed transactions in the last 12 months. Shown to homeowners with your proposals, labeled as reported by you — accuracy builds trust and wins business.</p>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
        <div>
          <label for="transactions_seller_12mo">Representing sellers</label>
          <input type="number" id="transactions_seller_12mo" name="transactions_seller_12mo" min="0" max="500" step="1" value="<%= p.transactions_seller_12mo === null ? '' : p.transactions_seller_12mo %>" placeholder="e.g. 8">
        </div>
        <div>
          <label for="transactions_buyer_12mo">Representing buyers</label>
          <input type="number" id="transactions_buyer_12mo" name="transactions_buyer_12mo" min="0" max="500" step="1" value="<%= p.transactions_buyer_12mo === null ? '' : p.transactions_buyer_12mo %>" placeholder="e.g. 12">
        </div>
      </div>
    </div>

    <button class="btn full" type="submit">Save settings</button>
  </form>
</div>
<%- include('../partials/foot') %>
