<%- include('../partials/head') %>
<h1>Welcome back, <%= user.name.split(' ')[0] %></h1>
<p class="sub"><%= profile.brokerage %> · Utah · <span style="color:var(--good); font-weight:600;">✓ License verified</span> · <a href="/agent/settings">Account settings</a></p>
<% if (profile.transactions_seller_12mo === null && profile.transactions_buyer_12mo === null) { %>
  <div class="card" style="border-left:4px solid var(--blue); padding:14px 18px;">
    <b style="color:var(--navy);">Add your track record.</b>
    <span class="sub" style="display:inline;">Homeowners see your 12-month transaction count next to your proposals. Professionals with a track record listed stand out.</span>
    <a href="/agent/settings" style="font-weight:600;">Add it in settings ›</a>
  </div>
<% } %>

<div class="stats">
  <div class="stat"><b><%= opportunities.length %></b><span>Open opportunities</span></div>
  <div class="stat"><b><%= stats.submitted %></b><span>Proposals submitted</span></div>
  <div class="stat"><b><%= stats.shortlisted %></b><span>Times shortlisted</span></div>
  <div class="stat"><b><%= stats.connected %></b><span>Clients won</span></div>
</div>

<% if (wins.length > 0) { %>
  <h2 style="margin-top:26px;">Clients won 🎉</h2>
  <div class="card">
    <% wins.forEach(w => { %>
      <div class="rowline">
        <div>
          <b style="color:var(--navy);"><%= w.seller_name %></b>
          <div class="meta"><%= w.property_type %> · <%= w.city %>, UT <%= w.zip %> · <%= w.price_range %></div>
        </div>
        <div class="actions">
          <span class="pill">📧 <%= w.seller_email %></span>
          <% if (w.seller_phone) { %><span class="pill">📱 <%= w.seller_phone %></span><% } %>
        </div>
      </div>
    <% }) %>
  </div>
  <p class="note">Reach out within 24 hours. The listing agreement is signed with your brokerage, outside Connexli.</p>
<% } %>

<% if (buyerWins.length > 0) { %>
  <h2 style="margin-top:26px;">Buyer clients won 🎉</h2>
  <div class="card">
    <% buyerWins.forEach(w => { %>
      <div class="rowline">
        <div>
          <b style="color:var(--navy);"><%= w.buyer_name %></b>
          <div class="meta">Buying in <%= w.search_areas %> · <%= w.price_range %> · <%= w.timeline %></div>
        </div>
        <div class="actions">
          <span class="pill">📧 <%= w.buyer_email %></span>
          <% if (w.buyer_phone) { %><span class="pill">📱 <%= w.buyer_phone %></span><% } %>
        </div>
      </div>
    <% }) %>
  </div>
  <p class="note">Reach out within 24 hours. The buyer representation agreement is signed with your brokerage, outside Connexli.</p>
<% } %>

<h2 style="margin-top:26px;">Seller opportunities</h2>
<% if (opportunities.length === 0) { %>
  <div class="card"><p class="sub">No open opportunities right now. New homeowner requests appear here the moment they launch.</p></div>
<% } else { %>
  <div class="tblwrap">
    <table class="dt">
      <tr><th>Property</th><th>Area</th><th>Price</th><th>Closes</th><th></th></tr>
      <% opportunities.forEach(o => { %>
        <tr>
          <td><b style="color:var(--navy);"><%= o.property_type %></b>
            <% if (o.mine > 0) { %><span class="badge approved">In 🔒</span><% } else if (o.round > 1) { %><span class="badge open">Fresh round</span><% } %>
            <br><span class="meta"><%= o.sqft_range %> sq ft · <%= o.beds %> bd/<%= o.baths %> ba</span></td>
          <td><%= o.city %> <%= o.zip %></td>
          <td><%= o.price_range %></td>
          <td data-sort="<%= new Date(o.closes_at).toISOString() %>"><span data-closes="<%= new Date(o.closes_at).toISOString() %>">⏱</span><br><span class="meta"><%= H.spotsLeft(o) %> spot<%= H.spotsLeft(o) === 1 ? '' : 's' %> left</span></td>
          <td><a class="btn sm <%= o.mine > 0 ? 'ghost' : '' %>" href="/agent/opportunities/<%= o.id %>"><%= o.mine > 0 ? 'Edit' : 'Propose' %></a></td>
        </tr>
      <% }) %>
    </table>
  </div>
  <div class="sealed">🔒 <span>Sealed process: you never see other professionals' proposals, and they never see yours. The homeowner's identity stays hidden until they choose to connect with you. Each round accepts at most <%= H.ROUND_CAP %> proposals and closes the moment it fills — don't wait until the last hour.</span></div>
<% } %>

<h2 style="margin-top:26px;">Buyer opportunities <span class="badge open" style="vertical-align:2px;">New</span></h2>
<% if (buyerOpps.length === 0) { %>
  <div class="card"><p class="sub">No published buyer profiles right now. Verified buyers looking for an agent appear here — anonymous snapshots with an honest readiness badge, so you always know who's worth a proposal.</p></div>
<% } else { %>
  <div class="tblwrap">
    <table class="dt">
      <tr><th>Buyer</th><th>Area</th><th>Price</th><th>Closes</th><th></th></tr>
      <% buyerOpps.forEach(b => { %>
        <tr>
          <td><b style="color:var(--navy);"><%= H.READINESS_LABELS[b.readiness] %></b>
            <% if (b.mine > 0) { %><span class="badge approved">In 🔒</span><% } else if (b.round > 1) { %><span class="badge open">Fresh round</span><% } %>
            <br><span class="meta"><%= b.timeline %><% if (!b.in_utah) { %> · from <%= b.origin_state %><% } %></span></td>
          <td><%= b.search_areas %></td>
          <td><%= b.price_range %></td>
          <td data-sort="<%= new Date(b.closes_at).toISOString() %>"><span data-closes="<%= new Date(b.closes_at).toISOString() %>">⏱</span><br><span class="meta"><%= H.spotsLeft(b) %> spot<%= H.spotsLeft(b) === 1 ? '' : 's' %> left</span></td>
          <td><a class="btn sm <%= b.mine > 0 ? 'ghost' : '' %>" href="/agent/buyers/<%= b.id %>"><%= b.mine > 0 ? 'Edit' : 'Propose' %></a></td>
        </tr>
      <% }) %>
    </table>
  </div>
<% } %>

<% if (myProposals.length > 0) { %>
  <h2 style="margin-top:26px;">My seller proposals</h2>
  <div class="tblwrap">
    <table class="dt">
      <tr><th>Property</th><th>Area</th><th>My fee</th><th>Submitted</th><th>Status</th><th></th></tr>
      <% myProposals.forEach(p => { %>
        <tr>
          <td><b style="color:var(--navy);"><%= p.property_type %></b></td>
          <td><%= p.city %>, UT <%= p.zip %></td>
          <td><%= H.feeLabel(p) %></td>
          <td data-sort="<%= new Date(p.created_at).toISOString() %>"><%= new Date(p.created_at).toLocaleDateString('en-US') %></td>
          <td><% if (p.connected) { %><span class="badge connected">Selected ✓</span>
            <% } else if (p.request_status === 'connected') { %><span class="badge closed">Not selected</span>
            <% } else if (p.shortlisted) { %><span class="badge open">Shortlisted ⭐</span>
            <% } else if (p.request_status === 'open' && p.round < p.request_round) { %><span class="badge pending">New round in progress</span>
            <% } else if (p.request_status === 'open') { %><span class="badge pending">Pending — sealed</span>
            <% } else { %><span class="badge closed">Pending decision</span><% } %></td>
          <td><a class="btn sm ghost" href="/agent/proposals/<%= p.id %>">Review</a></td>
        </tr>
      <% }) %>
    </table>
  </div>
  <p class="note">Review any proposal to see the full original request next to what you submitted — client identities are never shared.</p>
<% } %>

<% if (myBuyerProposals.length > 0) { %>
  <h2 style="margin-top:26px;">My buyer proposals</h2>
  <div class="tblwrap">
    <table class="dt">
      <tr><th>Buyer</th><th>Price range</th><th>My fee</th><th>Submitted</th><th>Status</th><th></th></tr>
      <% myBuyerProposals.forEach(p => { %>
        <tr>
          <td><b style="color:var(--navy);"><%= p.search_areas %></b></td>
          <td><%= p.b_price_range %></td>
          <td><%= H.buyerFeeLabel(p) %></td>
          <td data-sort="<%= new Date(p.created_at).toISOString() %>"><%= new Date(p.created_at).toLocaleDateString('en-US') %></td>
          <td><% if (p.connected) { %><span class="badge connected">Selected ✓</span>
            <% } else if (p.someone_won > 0) { %><span class="badge closed">Not selected</span>
            <% } else if (p.profile_status === 'active') { %><span class="badge pending">Pending</span>
            <% } else { %><span class="badge closed">Profile <%= p.profile_status %></span><% } %></td>
          <td><a class="btn sm ghost" href="/agent/buyer-proposals/<%= p.id %>">Review</a></td>
        </tr>
      <% }) %>
    </table>
  </div>
<% } %>
<script>
document.querySelectorAll('[data-closes]').forEach(function(el){
  var left = new Date(el.dataset.closes).getTime() - Date.now();
  if (left <= 0) { el.textContent = '⏱ closed'; return; }
  var d = Math.floor(left/86400000), h = Math.floor(left%86400000/3600000), m = Math.floor(left%3600000/60000);
  el.textContent = '⏱ closes in ' + (d > 0 ? d + 'd ' + h + 'h' : h > 0 ? h + 'h ' + m + 'm' : m + 'm');
});
</script>
<%- include('../partials/foot') %>
