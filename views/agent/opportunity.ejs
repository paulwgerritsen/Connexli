<%- include('../partials/head') %>
<a href="/agent" style="font-size:14px;">‹ Back to opportunities</a>
<div class="narrow" style="max-width:720px; margin:0;">
  <h1 style="margin-top:8px;"><%= request.property_type %> · <%= request.city %>, UT <%= request.zip %></h1>
  <p class="sub" data-closes="<%= new Date(request.closes_at).toISOString() %>" id="closesLine">Window status…</p>
  <% if (request.status === 'open' && request.proposal_count != null) { %>
    <p class="note"><%= H.takenThisRound(request) %> of <%= H.ROUND_CAP %> proposal spots taken this round · <%= H.spotsLeft(request) %> remaining<% if (request.round > 1) { %> (round <%= request.round %> — fresh competition only)<% } %>. The window closes the moment all spots fill, so don't wait until the deadline.</p>
  <% } %>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (typeof notice !== 'undefined' && notice) { %><div class="<%= notice.kind === 'error' ? 'error' : 'success' %>"><%= notice.text %></div><% } %>

  <%- include('../partials/seller-request-summary', { request }) %>

  <% if (request.status !== 'open') { %>
    <div class="sealed" style="margin-top:14px;">⏱ <span>This window has closed. <% if (proposal) { %>Your proposal was delivered sealed and is now visible to the homeowner alongside the others. You'll see "Shortlisted" or "Won" on your dashboard if they pick you.<% } else { %>Proposals can no longer be submitted.<% } %></span></div>
  <% } else if (blockedLicense) { %>
    <div class="card" style="border-left:4px solid #B42318;">
      <h2 style="color:#B42318;">License verification required</h2>
      <p class="sub">Your real estate license could not be verified as active, so proposal submissions are paused. Your account and any proposal credits are unaffected. Please contact us to resolve your license status.</p>
    </div>
  <% } else { %>
    <% const existing = !!(proposal && proposal.id); %>
    <% if (!existing && priority && credits.purchased <= 0) { %>
      <%# Priority period (Paul, Sep 2 §7): the opportunity stays fully visible
          and the form below can be drafted; only the complimentary credit is
          locked until the countdown ends. %>
      <div class="card" style="border-left:4px solid var(--blue);">
        <h2>🔒 Complimentary proposal access opens in <span data-priority-countdown="<%= new Date(priorityUntil).toISOString() %>">…</span></h2>
        <p class="sub" style="margin-bottom:0;">Purchased credits get <%= PRIORITY_HOURS %>-hour priority access to new opportunities. You can write your proposal now<%= purchasing ? ' and buy a credit below to submit immediately' : '' %> — or submit with a complimentary credit the moment the countdown ends. Proposal spots can fill during the priority period.</p>
      </div>
    <% } else if (!existing && !priority && credits.freeRemaining <= 0 && credits.purchased <= 0) { %>
      <div class="card" style="border-left:4px solid var(--blue);">
        <h2>Complimentary credits used for this month</h2>
        <p class="sub" style="margin-bottom:0;">You've used your <%= credits.freeTotal %> complimentary proposal credits for this month. They reset <%= credits.nextReset %>.<%= purchasing ? ' You can still propose now by buying a proposal credit below.' : ' Additional proposal credits will be available for purchase soon.' %></p>
      </div>
    <% } %>
    <div class="card">
      <h2><%= existing ? 'Edit your sealed proposal' : 'Your sealed proposal' %></h2>
      <% if (proposal && proposal.isDraft && !(typeof notice !== 'undefined' && notice)) { %><div class="success" style="margin-top:6px;">Your saved draft has been restored.</div><% } %>
      <form method="POST" action="/agent/opportunities/<%= request.id %>/propose">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="opp_type" value="seller">
        <input type="hidden" name="opp_id" value="<%= request.id %>">
        <%- include('../partials/seller-proposal-fields', { proposal, mid: H.midPrice(request.price_range) }) %>
        <% if (!existing) { %>
          <%- include('../partials/credit-choice', { oppType: 'seller' }) %>
        <% } %>
        <%- include('../partials/seller-listing-ack', { proposal }) %>
        <button class="btn full" type="submit" id="submitProposal" style="margin-top:18px;"><%= existing ? 'Update sealed proposal 🔒' : 'Submit sealed proposal 🔒' %></button>
        <p class="note">Sealed until the window closes. No other professional can see your pricing. By submitting you confirm your brokerage authorizes these terms; the final fee is set in the listing agreement.</p>
      </form>
      <% if (existing) { %>
        <form method="POST" action="/agent/opportunities/<%= request.id %>/withdraw" onsubmit="return confirm('Withdraw your proposal from this opportunity?');" style="margin-top:10px;">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn danger full" type="submit">Withdraw my proposal</button>
        </form>
      <% } %>
    </div>
  <% } %>
</div>
<script>
// Priority-window countdown (display only — the server enforces the rule).
// When it reaches zero the page reloads so the complimentary option unlocks.
(function(){
  var els = document.querySelectorAll('[data-priority-countdown]');
  if (!els.length) return;
  function tick(){
    var done = false;
    els.forEach(function(el){
      var left = new Date(el.dataset.priorityCountdown).getTime() - Date.now();
      if (left <= 0) { done = true; return; }
      var h = Math.floor(left/3600000), m = Math.floor(left%3600000/60000), s = Math.floor(left%60000/1000);
      el.textContent = h + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    });
    if (done) location.reload();
  }
  tick(); setInterval(tick, 1000);
})();
var line = document.getElementById('closesLine');
var left = new Date(line.dataset.closes).getTime() - Date.now();
if (left > 0) {
  var d = Math.floor(left/86400000), h = Math.floor(left%86400000/3600000), m = Math.floor(left%3600000/60000);
  // Singular/plural ("1 day", not "1 days") — matches the buyer snapshot countdown.
  line.textContent = 'Sealed window closes in ' + (d > 0 ? d + (d === 1 ? ' day ' : ' days ') + h + (h === 1 ? ' hr' : ' hrs') : h + (h === 1 ? ' hr ' : ' hrs ') + m + ' min');
} else { line.textContent = 'This window has closed.'; }
</script>
<%- include('../partials/foot') %>
