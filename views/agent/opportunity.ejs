<%- include('../partials/head') %>
<a href="/agent" style="font-size:14px;">‹ Back to opportunities</a>
<div class="narrow" style="max-width:720px; margin:0;">
  <h1 style="margin-top:8px;"><%= request.property_type %> · <%= request.city %>, UT <%= request.zip %></h1>
  <p class="sub" data-closes="<%= new Date(request.closes_at).toISOString() %>" id="closesLine">Window status…</p>
  <% if (request.status === 'open' && request.proposal_count != null) { %>
    <p class="note"><%= H.takenThisRound(request) %> of <%= H.ROUND_CAP %> proposal spots taken this round · <%= H.spotsLeft(request) %> remaining<% if (request.round > 1) { %> (round <%= request.round %> — fresh competition only)<% } %>. The window closes the moment all spots fill, so don't wait until the deadline.</p>
  <% } %>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <div class="card">
    <div class="sumrow"><span>Size</span><span><%= request.sqft_range %> sq ft · <%= request.beds %> bd · <%= request.baths %> ba</span></div>
    <div class="sumrow"><span>Built</span><span><%= request.year_built %> · <%= request.condition %> · HOA: <%= request.hoa %></span></div>
    <div class="sumrow"><span>Price range</span><span><%= request.price_range %></span></div>
    <div class="sumrow"><span>Seller priorities</span><span><%= request.priorities || 'Balanced' %></span></div>
    <% if (request.neighborhood) { %><div class="sumrow"><span>Area</span><span><%= request.neighborhood %></span></div><% } %>
  </div>

  <% if (request.status !== 'open') { %>
    <div class="sealed" style="margin-top:14px;">⏱ <span>This window has closed. <% if (proposal) { %>Your proposal was delivered sealed and is now visible to the homeowner alongside the others. You'll see "Shortlisted" or "Won" on your dashboard if they pick you.<% } else { %>Proposals can no longer be submitted.<% } %></span></div>
  <% } else if (blockedLicense) { %>
    <div class="card" style="border-left:4px solid #B42318;">
      <h2 style="color:#B42318;">License verification required</h2>
      <p class="sub">Your real estate license could not be verified as active, so proposal submissions are paused. Your account and any proposal credits are unaffected. Please contact us to resolve your license status.</p>
    </div>
  <% } else if (!proposal && priority && credits.purchased <= 0) { %>
    <div class="card" style="border-left:4px solid var(--blue);">
      <h2>🔒 Complimentary proposal access hasn't opened yet</h2>
      <p class="sub">Purchased proposal credits receive <%= PRIORITY_HOURS %>-hour priority access to new Connexli opportunities.</p>
      <p style="font-weight:700; color:var(--navy); margin:10px 0 2px;">Your complimentary access opens in:</p>
      <p style="font-size:26px; font-weight:800; color:var(--navy); margin:0 0 10px;"><span data-priority-countdown="<%= new Date(priorityUntil).toISOString() %>">…</span></p>
      <b style="color:var(--navy);">Purchase proposal credits for immediate access <span class="badge pending">Coming soon</span></b>
      <p class="note" style="margin-bottom:0;">You can review everything about this opportunity now and submit the moment the countdown ends. Nothing about your account changes while you wait — but proposal spots can fill during the priority period.</p>
    </div>
  <% } else if (!proposal && !priority && credits.freeRemaining <= 0 && credits.purchased <= 0) { %>
    <div class="card" style="border-left:4px solid var(--blue);">
      <h2>Complimentary credits used for this month</h2>
      <p class="sub">You've used your <%= credits.freeTotal %> complimentary proposal credits for this month. Your complimentary credits reset <%= credits.nextReset %>. Additional proposal credits will also be available for purchase soon.</p>
      <p class="note" style="margin-bottom:0;">You can keep browsing every open opportunity — nothing about your account changes when your credits run out.</p>
    </div>
  <% } else { %>
    <div class="card">
      <h2><%= proposal ? 'Edit your sealed proposal' : 'Your sealed proposal' %></h2>
      <form method="POST" action="/agent/opportunities/<%= request.id %>/propose">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <p class="note" style="margin-top:2px;">The amount below is your <b>proposed listing-side compensation</b> — what you propose to charge for representing the seller. Connexli presents it to the homeowner as separate from any compensation that may involve a buyer's agent.</p>
        <label>Compensation type</label>
        <div class="optgrid cols keep2">
          <label class="opt"><input type="radio" name="fee_type" value="pct" <%= (!proposal || proposal.fee_type === 'pct') ? 'checked' : '' %> onchange="feeLbl()"><span class="tile"><b>% of sale price</b></span></label>
          <label class="opt"><input type="radio" name="fee_type" value="flat" <%= (proposal && proposal.fee_type === 'flat') ? 'checked' : '' %> onchange="feeLbl()"><span class="tile"><b>Flat fee ($)</b></span></label>
        </div>
        <label for="fee_amount" id="feeAmtLbl">Listing fee</label>
        <input type="text" id="fee_amount" name="fee_amount" inputmode="decimal" value="<%= proposal ? parseFloat(proposal.fee_amount) : '' %>" placeholder="e.g. 1.25" required>
        <p class="note" id="feePrev"></p>

        <label>Included services</label>
        <div class="optgrid cols">
          <% H.SERVICES.forEach(s => { %>
            <label class="opt"><input type="checkbox" name="services" value="<%= s %>" <%= (proposal && (proposal.services || '').includes(s)) ? 'checked' : '' %>><span class="tile"><b style="font-weight:500;"><%= s %></b></span></label>
          <% }) %>
        </div>

        <label for="marketing_plan">Marketing plan <span class="hint">(the homeowner sees this)</span></label>
        <textarea id="marketing_plan" name="marketing_plan" rows="4" maxlength="2000"><%= proposal ? proposal.marketing_plan : '' %></textarea>
        <p class="note" style="text-align:right; margin-top:2px;"><span id="mpCount">0</span> / 2000 characters</p>
        <script>
        (function(){
          var t = document.getElementById('marketing_plan'), c = document.getElementById('mpCount');
          function upd(){ c.textContent = t.value.length; c.parentNode.style.color = t.value.length >= 2000 ? '#B42318' : ''; }
          t.addEventListener('input', upd); upd();
        })();
        </script>

        <label for="cancellation_terms">Cancellation terms</label>
        <select id="cancellation_terms" name="cancellation_terms">
          <% H.CANCELLATION.forEach(c => { %><option <%= (proposal && proposal.cancellation_terms === c) ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>

        <% if (!proposal) { %>
          <%# Credit choice (Paul, Aug 31 §4): the professional picks which
              credit funds this NEW submission. During the priority window the
              complimentary option is locked — and the server enforces the
              same rule regardless of what the browser shows. %>
          <label style="margin-top:16px;">Submit this proposal using</label>
          <div class="optgrid cols">
            <label class="opt" style="<%= (priority || credits.freeRemaining <= 0) ? 'opacity:.55;' : '' %>">
              <input type="radio" name="credit_choice" value="complimentary"
                <%= (priority || credits.freeRemaining <= 0) ? 'disabled' : '' %>
                <%= (!priority && credits.freeRemaining > 0) ? 'checked' : '' %>>
              <span class="tile"><span><b>Use a complimentary credit</b>
                <span class="desc"><% if (priority) { %>🔒 opens in <span data-priority-countdown="<%= new Date(priorityUntil).toISOString() %>">…</span> — purchased credits get <%= PRIORITY_HOURS %>-hour priority<% } else if (credits.freeRemaining <= 0) { %>0 remaining this month · resets <%= credits.nextReset %><% } else { %><%= credits.freeRemaining %> remaining this month · resets <%= credits.nextReset %><% } %></span></span></span>
            </label>
            <label class="opt" style="<%= credits.purchased <= 0 ? 'opacity:.55;' : '' %>">
              <input type="radio" name="credit_choice" value="purchased"
                <%= credits.purchased <= 0 ? 'disabled' : '' %>
                <%= (credits.purchased > 0 && (priority || credits.freeRemaining <= 0)) ? 'checked' : '' %>>
              <span class="tile"><span><b>Use a purchased credit</b>
                <span class="desc"><%= credits.purchased %> available · purchased credits never expire</span></span></span>
            </label>
          </div>
        <% } %>
        <label style="display:flex; gap:10px; align-items:flex-start; margin-top:16px; cursor:pointer;">
          <input type="checkbox" name="listing_ack" value="yes" required style="margin-top:4px; width:16px; height:16px; flex:none; accent-color:var(--blue);">
          <span style="font-size:13px; color:var(--muted); line-height:1.5; font-weight:400;">I understand that the compensation entered above represents my proposed listing-side compensation. Connexli will present it to the homeowner as separate from any compensation that may involve a buyer's agent.</span>
        </label>
        <button class="btn full" type="submit" style="margin-top:18px;"><%= proposal ? 'Update sealed proposal 🔒' : 'Submit sealed proposal 🔒' %></button>
        <p class="note">Sealed until the window closes. No other professional can see your pricing. By submitting you confirm your brokerage authorizes these terms; the final fee is set in the listing agreement.</p>
      </form>
      <% if (proposal) { %>
        <form method="POST" action="/agent/opportunities/<%= request.id %>/withdraw" onsubmit="return confirm('Withdraw your proposal from this opportunity?');" style="margin-top:10px;">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn danger full" type="submit">Withdraw my proposal</button>
        </form>
      <% } %>
    </div>
  <% } %>
</div>
<script>
var MID = <%= H.midPrice(request.price_range) %>;
function feeLbl(){
  var pct = document.querySelector('input[name="fee_type"][value="pct"]').checked;
  document.getElementById('feeAmtLbl').textContent = pct ? 'Your proposed listing-side compensation (%)' : 'Your proposed listing-side compensation (flat $)';
  prev();
}
function prev(){
  var pct = document.querySelector('input[name="fee_type"][value="pct"]').checked;
  var v = parseFloat(String(document.getElementById('fee_amount').value).replace(/[^0-9.]/g,'')) || 0;
  var est = pct ? Math.round(MID * v / 100) : Math.round(v);
  document.getElementById('feePrev').textContent = v > 0
    ? 'The homeowner sees: ' + (pct ? v + '%' : '$' + est.toLocaleString() + ' flat') + ' · estimated $' + est.toLocaleString() + ' on a $' + MID.toLocaleString() + ' sale'
    : 'Estimated fee preview appears as you type.';
}
if (document.getElementById('fee_amount')) {
  document.getElementById('fee_amount').addEventListener('input', prev);
  feeLbl();
}
// Priority-window countdown (display only — the server enforces the rule).
// When it reaches zero the page reloads so the complimentary option unlocks.
(function(){
  var els = document.querySelectorAll('[data-priority-countdown]');
  if (!els.length) return;
  function tick(){
    var done = false;
    els.forEach(function(el){
      var left = new Date(el.dataset.priorityCountdown).getTime() - Date.now();
      if (left <= 0) { done = true; return; }
      var h = Math.floor(left/3600000), m = Math.floor(left%3600000/60000), s = Math.floor(left%60000/1000);
      el.textContent = h + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    });
    if (done) location.reload();
  }
  tick(); setInterval(tick, 1000);
})();
var line = document.getElementById('closesLine');
var left = new Date(line.dataset.closes).getTime() - Date.now();
if (left > 0) {
  var d = Math.floor(left/86400000), h = Math.floor(left%86400000/3600000), m = Math.floor(left%3600000/60000);
  line.textContent = 'Sealed window closes in ' + (d > 0 ? d + ' days ' + h + ' hrs' : h + ' hrs ' + m + ' min');
} else { line.textContent = 'This window has closed.'; }
</script>
<%- include('../partials/foot') %>
