<%- include('../partials/head') %>
<a href="/agent" style="font-size:14px;">‹ Back to opportunities</a>
<div class="narrow" style="max-width:720px; margin:0;">
  <h1 style="margin-top:8px;">Buyer Snapshot <span class="badge <%= buyer.readiness === 'ready_now' ? 'connected' : 'open' %>" style="vertical-align:4px;"><%= H.READINESS_LABELS[buyer.readiness] %></span></h1>
  <p class="sub" id="oppMeta" data-closes="<%= new Date(buyer.closes_at).toISOString() %>">
    <b style="color:var(--blue);"><%= H.takenThisRound(buyer) %> proposal<%= H.takenThisRound(buyer) === 1 ? '' : 's' %> submitted · <%= H.spotsLeft(buyer) %> spot<%= H.spotsLeft(buyer) === 1 ? '' : 's' %> remaining</b><% if (buyer.round > 1) { %> (round <%= buyer.round %>)<% } %> · anonymous until they choose<br>
    <span id="oppCountdown">…</span> · closes <%= new Date(buyer.closes_at).toLocaleString('en-US', { timeZone: 'America/Denver' }) %> (Mountain) — or the moment all spots fill
  </p>
  <script>
  (function(){
    var el = document.getElementById('oppMeta');
    var cd = document.getElementById('oppCountdown');
    var closes = new Date(el.dataset.closes).getTime();
    function tick(){
      var left = closes - Date.now();
      if (left <= 0) { cd.textContent = 'This window has closed.'; return; }
      var d = Math.floor(left/86400000), h = Math.floor(left%86400000/3600000), m = Math.floor(left%3600000/60000);
      cd.textContent = '⏱ ' + (d > 0 ? d + (d === 1 ? ' day ' : ' days ') + h + ' hrs' : h + (h === 1 ? ' hour ' : ' hours ') + m + ' min') + ' left';
    }
    tick(); setInterval(tick, 30000);
  })();
  </script>
  <% if (typeof error === 'string' && error) { %><div class="error"><%= error %></div><% } %>

  <div class="card">
    <div class="sumrow"><span>Financing</span><span><b><%= buyer.financing_type %></b> · <%= buyer.lender_status %> · <%= buyer.down_payment %> down</span></div>
    <div class="sumrow"><span>Price range & purpose</span><span><%= buyer.price_range %> · <%= buyer.purchase_purpose %></span></div>
    <div class="sumrow"><span>Timeline</span><span><%= buyer.timeline %></span></div>
    <div class="sumrow"><span>Search areas</span><span><%= buyer.search_areas %></span></div>
    <div class="sumrow"><span>Current home</span><span><%= buyer.current_situation %><%= buyer.need_to_sell !== 'No' ? ' · Must sell first (' + buyer.need_to_sell.replace('Yes — ','') + ')' : '' %></span></div>
    <% if (!buyer.in_utah) { %><div class="sumrow"><span>Relocation</span><span>From <%= buyer.origin_state %><%= buyer.move_reason ? ' · ' + buyer.move_reason : '' %><%= buyer.visit_dates ? ' · visiting ' + buyer.visit_dates : '' %></span></div><% } %>
    <% if (buyer.video_tours) { %><div class="sumrow"><span>Video tours</span><span>Yes — this buyer would like video / virtual tours</span></div><% } %>
    <% if (buyer.property_prefs) { %><div class="sumrow"><span>Looking for</span><span><%= buyer.property_prefs %></span></div><% } %>
    <% if (buyer.priorities) { %><div class="sumrow"><span>Top priorities</span><span><%= buyer.priorities %></span></div><% } %>
    <% if (buyer.availability) { %><div class="sumrow"><span>Tour availability</span><span><%= buyer.availability %></span></div><% } %>
    <% if (buyer.first_time === true) { %><div class="sumrow"><span>First-time buyer</span><span>Yes</span></div><% } %>
    <% if (buyer.notes) { %><div class="sumrow"><span>In their words</span><span><%= buyer.notes %></span></div><% } %>
  </div>

  <% if (typeof proposal !== 'undefined' && proposal && proposal.id) { %>
    <div class="success">Your sealed proposal is in 🔒 — you can update it below any time while the profile is active.</div>
  <% } %>

  <h2 style="margin-top:22px;"><%= proposal && proposal.id ? 'Update your sealed proposal' : 'Submit your sealed proposal' %></h2>
  <p class="sub">Buyer representation takes real time — structure your fee to protect it. Buyers see every structure explained plainly, side by side.</p>

  <form method="POST" action="/agent/buyers/<%= buyer.id %>/propose">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="card">
      <p class="note" style="margin-top:2px;">The amount below is your <b>proposed buyer-agent compensation</b> — presented to the buyer with a reminder that the source of payment can vary by transaction and that their own agreement governs what they owe.</p>
      <label>Fee structure</label>
      <div class="optgrid cols" style="grid-template-columns:1fr 1fr;">
        <label class="opt"><input type="radio" name="comp_structure" value="pct" <%= (!proposal || proposal.comp_structure === 'pct' || !['pct','flat'].includes(proposal.comp_structure)) ? 'checked' : '' %> onchange="bFee()"><span class="tile"><b>% of purchase price</b><span class="desc">at closing</span></span></label>
        <label class="opt"><input type="radio" name="comp_structure" value="flat" <%= (proposal && proposal.comp_structure === 'flat') ? 'checked' : '' %> onchange="bFee()"><span class="tile"><b>Flat fee ($)</b><span class="desc">at closing</span></span></label>
      </div>
      <label for="comp_amount" id="bFeeLbl">Your proposed buyer-agent compensation</label>
      <input type="text" id="comp_amount" name="comp_amount" inputmode="decimal" placeholder="e.g. 2.5 or 6000" value="<%= proposal ? parseFloat(proposal.comp_amount) || '' : '' %>" required>
      <p class="note" id="bFeePrev"></p>
      <label for="min_fee">Minimum fee in dollars (optional)</label>
      <input type="text" id="min_fee" name="min_fee" placeholder="e.g. 5000" value="<%= proposal && proposal.min_fee ? parseFloat(proposal.min_fee) : '' %>">
      <label>If the seller does not pay the full buyer-agent compensation agreed between you and your client, will the buyer be responsible for paying the remaining balance at closing?</label>
      <div class="optgrid cols" style="grid-template-columns:1fr 1fr;">
        <label class="opt"><input type="radio" name="gap_responsibility" value="Yes" <%= (!proposal || proposal.gap_responsibility !== 'No') ? 'checked' : '' %>><span class="tile"><b>Yes</b><span class="desc">buyer covers any remaining balance</span></span></label>
        <label class="opt"><input type="radio" name="gap_responsibility" value="No" <%= (proposal && proposal.gap_responsibility === 'No') ? 'checked' : '' %>><span class="tile"><b>No</b><span class="desc">I won't ask the buyer to cover a shortfall</span></span></label>
      </div>
      <label for="rebate">Rebate offer, if any (optional — rebates are legal in Utah)</label>
      <input type="text" id="rebate" name="rebate" value="<%= proposal ? proposal.rebate : '' %>">
    </div>
    <div class="card">
      <label for="included_tours">Tours included</label>
      <select id="included_tours" name="included_tours">
        <% H.BP_TOURS.forEach(t => { %><option <%= proposal && proposal.included_tours === t ? 'selected' : '' %>><%= t %></option><% }) %>
      </select>
      <div class="optgrid" style="margin-top:8px;">
        <label class="opt"><input type="checkbox" name="video_tours" value="yes" <%= proposal && proposal.video_tours ? 'checked' : '' %>><span class="tile"><b style="font-weight:600;">I offer video / virtual tours</b><span class="desc">important for relocating buyers</span></span></label>
      </div>
      <label for="response_time">Response-time commitment</label>
      <select id="response_time" name="response_time">
        <% H.BP_RESPONSE.forEach(r => { %><option <%= proposal && proposal.response_time === r ? 'selected' : '' %>><%= r %></option><% }) %>
      </select>
      <label>Your specialties</label>
      <div class="optgrid cols">
        <% H.BP_SPECIALTIES.forEach(s => { %>
          <label class="opt"><input type="checkbox" name="specialties" value="<%= s %>" <%= proposal && (proposal.specialties || '').includes(s) ? 'checked' : '' %>><span class="tile"><b style="font-weight:500;"><%= s %></b></span></label>
        <% }) %>
      </div>
      <label for="plan">Your plan for this buyer</label>
      <textarea id="plan" name="plan" rows="4" maxlength="2000" placeholder="What you'd do for this buyer specifically — their areas, their timeline, their situation."><%= proposal ? proposal.plan : '' %></textarea>
      <p class="note" style="text-align:right; margin-top:2px;"><span id="planCount">0</span> / 2000 characters</p>
      <script>
      (function(){
        var t = document.getElementById('plan'), c = document.getElementById('planCount');
        function upd(){ c.textContent = t.value.length; c.parentNode.style.color = t.value.length >= 2000 ? '#B42318' : ''; }
        t.addEventListener('input', upd); upd();
      })();
      </script>
    </div>
    <button class="btn full" type="submit"><%= proposal && proposal.id ? 'Update my sealed proposal' : 'Submit my sealed proposal' %></button>
  </form>

  <% if (proposal && proposal.id && !proposal.connected) { %>
    <form method="POST" action="/agent/buyers/<%= buyer.id %>/withdraw" onsubmit="return confirm('Withdraw your proposal for this buyer?');" style="margin-top:10px;">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn ghost full danger" type="submit">Withdraw my proposal</button>
    </form>
  <% } %>
  <div class="sealed" style="margin-top:14px;">🔒 <span>Sealed means sealed: competing professionals never see your terms, and the buyer's identity stays hidden until they choose to connect with you.</span></div>
</div>
<script>
// Live estimated-compensation preview at the midpoint of the buyer's range.
var B_MID = <%= H.midPrice(buyer.price_range) %>;
function bFee(){
  var pct = document.querySelector('input[name="comp_structure"][value="pct"]').checked;
  document.getElementById('bFeeLbl').textContent = pct ? 'Your proposed buyer-agent compensation (%)' : 'Your proposed buyer-agent compensation (flat $)';
  bPrev();
}
function bPrev(){
  var pct = document.querySelector('input[name="comp_structure"][value="pct"]').checked;
  var v = parseFloat(String(document.getElementById('comp_amount').value).replace(/[^0-9.]/g,'')) || 0;
  var est = pct ? Math.round(B_MID * v / 100) : Math.round(v);
  document.getElementById('bFeePrev').textContent = v > 0
    ? 'The buyer sees: ' + (pct ? v + '% at closing' : '$' + est.toLocaleString() + ' flat') + ' · estimated compensation ≈ $' + est.toLocaleString() + (pct ? ' at their range midpoint ($' + B_MID.toLocaleString() + ')' : '')
    : 'Estimated compensation preview appears as you type.';
}
document.getElementById('comp_amount').addEventListener('input', bPrev);
bFee();
</script>
<%- include('../partials/foot') %>
