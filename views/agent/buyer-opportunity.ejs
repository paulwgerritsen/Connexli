<%- include('../partials/head') %>
<a href="/agent" style="font-size:14px;">‹ Back to opportunities</a>
<div class="narrow" style="max-width:720px; margin:0;">
  <h1 style="margin-top:8px;">Buyer Snapshot <span class="badge <%= buyer.readiness === 'ready_now' ? 'connected' : 'open' %>" style="vertical-align:4px;"><%= H.READINESS_LABELS[buyer.readiness] %></span></h1>
  <p class="sub" id="oppMeta" data-closes="<%= new Date(buyer.closes_at).toISOString() %>">
    <b style="color:var(--blue);"><%= H.takenThisRound(buyer) %> proposal<%= H.takenThisRound(buyer) === 1 ? '' : 's' %> submitted · <%= H.spotsLeft(buyer) %> spot<%= H.spotsLeft(buyer) === 1 ? '' : 's' %> remaining</b><% if (buyer.round > 1) { %> (round <%= buyer.round %>)<% } %> · anonymous until they choose<br>
    <span id="oppCountdown">…</span> · closes <%= new Date(buyer.closes_at).toLocaleString('en-US', { timeZone: 'America/Denver' }) %> (Mountain) — or the moment all spots fill
  </p>
  <script>
  (function(){
    var el = document.getElementById('oppMeta');
    var cd = document.getElementById('oppCountdown');
    var closes = new Date(el.dataset.closes).getTime();
    function tick(){
      var left = closes - Date.now();
      if (left <= 0) { cd.textContent = 'This window has closed.'; return; }
      var d = Math.floor(left/86400000), h = Math.floor(left%86400000/3600000), m = Math.floor(left%3600000/60000);
      cd.textContent = '⏱ ' + (d > 0 ? d + (d === 1 ? ' day ' : ' days ') + h + ' hrs' : h + (h === 1 ? ' hour ' : ' hours ') + m + ' min') + ' left';
    }
    tick(); setInterval(tick, 30000);
  })();
  </script>
  <% if (typeof error === 'string' && error) { %><div class="error"><%= error %></div><% } %>
  <% if (typeof notice !== 'undefined' && notice) { %><div class="<%= notice.kind === 'error' ? 'error' : 'success' %>"><%= notice.text %></div><% } %>

  <%- include('../partials/buyer-snapshot', { buyer }) %>

  <% if (typeof proposal !== 'undefined' && proposal && proposal.id) { %>
    <div class="success">Your sealed proposal is in 🔒 — you can update it below any time while the profile is active.</div>
  <% } %>

  <% if (typeof blockedLicense !== 'undefined' && blockedLicense) { %>
    <div class="card" style="border-left:4px solid #B42318; margin-top:22px;">
      <h2 style="color:#B42318;">License verification required</h2>
      <p class="sub">Your real estate license could not be verified as active, so proposal submissions are paused. Your account and any proposal credits are unaffected. Please contact us to resolve your license status.</p>
    </div>
  <% } else { %>
  <% const existing = !!(proposal && proposal.id); %>
  <% if (!existing && priority && credits.purchased <= 0) { %>
    <%# Priority period (Paul, Sep 2 §7): the opportunity stays fully visible
        and the form below can be drafted; only the complimentary credit is
        locked until the countdown ends. %>
    <div class="card" style="border-left:4px solid var(--blue); margin-top:22px;">
      <h2>🔒 Complimentary proposal access opens in <span data-priority-countdown="<%= new Date(priorityUntil).toISOString() %>">…</span></h2>
      <p class="sub" style="margin-bottom:0;">Purchased credits get <%= PRIORITY_HOURS %>-hour priority access to new opportunities. You can write your proposal now<%= purchasing ? ' and buy a credit below to submit immediately' : '' %> — or submit with a complimentary credit the moment the countdown ends. Proposal spots can fill during the priority period.</p>
    </div>
  <% } else if (!existing && !priority && credits.freeRemaining <= 0 && credits.purchased <= 0) { %>
    <div class="card" style="border-left:4px solid var(--blue); margin-top:22px;">
      <h2>Complimentary credits used for this month</h2>
      <p class="sub" style="margin-bottom:0;">You've used your <%= credits.freeTotal %> complimentary proposal credits for this month. They reset <%= credits.nextReset %>.<%= purchasing ? ' You can still propose now by buying a proposal credit below.' : ' Additional proposal credits will be available for purchase soon.' %></p>
    </div>
  <% } %>
  <h2 style="margin-top:22px;"><%= existing ? 'Update your sealed proposal' : 'Submit your sealed proposal' %></h2>
  <p class="sub">Buyer representation takes real time — structure your fee to protect it. Buyers see every structure explained plainly, side by side.</p>
  <% if (proposal && proposal.isDraft && !(typeof notice !== 'undefined' && notice)) { %><div class="success">Your saved draft has been restored.</div><% } %>

  <form method="POST" action="/agent/buyers/<%= buyer.id %>/propose">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="opp_type" value="buyer">
    <input type="hidden" name="opp_id" value="<%= buyer.id %>">
    <%- include('../partials/buyer-proposal-fields', { proposal, mid: H.midPrice(buyer.price_range) }) %>
    <% if (!existing) { %>
      <div class="card">
        <%- include('../partials/credit-choice', { oppType: 'buyer' }) %>
      </div>
    <% } %>
    <button class="btn full" type="submit" id="submitProposal"><%= existing ? 'Update my sealed proposal' : 'Submit my sealed proposal' %></button>
  </form>
  <% } %>

  <% if (proposal && proposal.id && !proposal.connected) { %>
    <form method="POST" action="/agent/buyers/<%= buyer.id %>/withdraw" onsubmit="return confirm('Withdraw your proposal for this buyer?');" style="margin-top:10px;">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn ghost full danger" type="submit">Withdraw my proposal</button>
    </form>
  <% } %>
  <div class="sealed" style="margin-top:14px;">🔒 <span>Sealed means sealed: competing professionals never see your terms, and the buyer's identity stays hidden until they choose to connect with you.</span></div>
</div>
<script>
// Priority-window countdown (display only — the server enforces the rule).
(function(){
  var els = document.querySelectorAll('[data-priority-countdown]');
  if (!els.length) return;
  function tick(){
    var done = false;
    els.forEach(function(el){
      var left = new Date(el.dataset.priorityCountdown).getTime() - Date.now();
      if (left <= 0) { done = true; return; }
      var h = Math.floor(left/3600000), m = Math.floor(left%3600000/60000), s = Math.floor(left%60000/1000);
      el.textContent = h + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    });
    if (done) location.reload();
  }
  tick(); setInterval(tick, 1000);
})();
</script>
<%- include('../partials/foot') %>
