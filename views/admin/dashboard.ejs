<%- include('../partials/head') %>
<h1>Pilot control room</h1>
<p class="sub">Approve professionals, watch marketplace health, keep the promise: verified pros only. · <a href="/admin/analytics">Marketplace analytics ›</a> · <a href="/admin/waitlist">Expansion waitlist ›</a> · <a href="/admin/contact">Contact messages ›</a> · <a href="/admin/feedback">Connection feedback ›</a></p>

<div class="stats">
  <div class="stat"><b><%= m.sellers %></b><span>Homeowners</span></div>
  <div class="stat"><b><%= m.approved_agents %></b><span>Verified professionals</span></div>
  <div class="stat"><b><%= m.pending_agents %></b><span>Pending approvals</span></div>
  <div class="stat"><b><%= m.open_requests %></b><span>Open opportunities</span></div>
  <div class="stat"><b><%= m.completed_requests %></b><span>Completed opportunities</span></div>
  <div class="stat"><b><%= m.total_proposals %></b><span>Proposals submitted</span></div>
  <div class="stat"><b><%= m.connected_requests %></b><span>Homeowner selections</span></div>
  <div class="stat"><b><%= m.avg_proposals %></b><span>Avg proposals per opportunity</span></div>
  <div class="stat"><b><%= m.active_buyers %></b><span>Live buyer profiles</span></div>
  <div class="stat"><b><%= m.exploring_buyers %></b><span>Buyers getting ready</span></div>
  <div class="stat"><b><%= m.buyer_proposals %></b><span>Buyer proposals</span></div>
  <div class="stat"><b><%= m.buyer_connections %></b><span>Buyer connections</span></div>
</div>

<details class="sect" open><summary><h2>Verification queue<% if (pending.length) { %> · <%= pending.length %> waiting<% } %></h2></summary>
<% if (pending.length === 0) { %>
  <div class="card"><p class="sub">No professionals waiting for review. 🎉</p></div>
<% } else { %>
  <div class="card">
    <% pending.forEach(a => { %>
      <%# v20 (Paul, Sep 1 §10): each pending application shows WHERE it is in
          the pipeline. Auto-rejected applications never appear here at all —
          they land in Rejected professionals. %>
      <% const stage = !a.email_verified ? 'Awaiting email verification'
           : a.verification_status === 'needs_review' ? 'Needs review'
           : ['needs_verification', 'unable_to_verify'].includes(a.verification_status) ? 'Awaiting license verification'
           : null; %>
      <div class="rowline">
        <div>
          <a href="/admin/agents/<%= a.user_id %>" style="font-weight:700; color:var(--navy);"><%= a.name %></a> <span class="meta">· <%= a.email %><% if (a.phone) { %> · <%= a.phone %><% } %></span><% if (stage) { %> <span class="badge pending"><%= stage %></span><% } %>
          <div class="meta">License <b><%= a.license_number %></b> · <%= a.brokerage %> · <%= a.state %><% if (a.service_zip) { %> · Serves <%= a.service_zip %><%= a.service_city ? ' (' + a.service_city + ')' : '' %><% } %> · applied <%= new Date(a.created_at).toLocaleDateString('en-US') %></div>
          <div class="meta">License check: <span class="badge <%= VB[a.verification_status] || 'pending' %>"><%= VL[a.verification_status] || a.verification_status %></span><% if (a.name_mismatch && a.verification_status === 'needs_review') { %> · <b style="color:#B45309;">name differs from registry</b><% } %><% if (a.brokerage_mismatch && a.verification_status === 'needs_review') { %> · <b style="color:#B45309;">brokerage differs from registry</b><% } %><% if (a.reld_error) { %> · <span style="color:#B42318;"><%= a.reld_error %></span><% } %></div>
          <div class="meta"><a href="https://secure.utah.gov/llv/search/index.html" target="_blank" rel="noopener">Check license in the Utah license lookup ↗</a> (verify: active status, name matches, brokerage matches)</div>
        </div>
        <div class="actions">
          <% if (a.verification_status === 'failed') { %>
            <span class="meta" style="color:#B42318; font-weight:600;">License not found — cannot approve</span>
          <% } else { %>
            <form method="POST" action="/admin/agents/<%= a.user_id %>/approve">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn sm" type="submit">Approve</button>
            </form>
          <% } %>
          <form method="POST" action="/admin/agents/<%= a.user_id %>/reject" onsubmit="return confirm('Reject this professional? They will be told verification was unsuccessful.');">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn danger sm" type="submit">Reject</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

</details>

<details class="sect" open><summary><h2>Seller requests · <%= requests.length %></h2></summary>
<div class="tblwrap">
  <table class="dt">
    <tr><th>Request</th><th>Seller</th><th>Window</th><th>Status</th><th>Proposals</th><th>Created</th></tr>
    <% requests.forEach(r => { %>
      <tr>
        <td><a href="/admin/requests/<%= r.id %>"><%= r.property_type %> · <%= r.city %> <%= r.zip %></a> · <%= r.price_range %></td>
        <td><%= r.seller_name %></td>
        <td><%= r.window_hours === 168 ? '7 days' : r.window_hours + ' hrs' %></td>
        <td><span class="badge <%= r.status %>"><%= r.status %></span></td>
        <td><%= r.proposal_count %></td>
        <td><%= new Date(r.created_at).toLocaleDateString('en-US') %></td>
      </tr>
    <% }) %>
  </table>
</div>

</details>

<details class="sect" open><summary><h2>Buyer requests · <%= buyers.length %></h2></summary>
<% if (buyers.length === 0) { %>
  <div class="card"><p class="sub">No buyer profiles yet. They'll appear here as buyers use Find Your Buyer's Agent.</p></div>
<% } else { %>
<div class="tblwrap">
  <table class="dt">
    <%# Mirrors the Seller requests table (Paul, Aug 21): same column order,
        same status vocabulary (open/closed/connected), plain proposal count.
        The status is DERIVED from the request's actual state, not relabeled:
        open = window still accepting proposals, closed = window ended and
        the buyer is deciding, connected = professional selected. %>
    <tr><th>Buyer</th><th>Search</th><th>Window</th><th>Status</th><th>Proposals</th><th>Created</th></tr>
    <% buyers.forEach(b => { %>
      <% const st = b.status === 'connected' ? 'connected'
           : b.status === 'active' ? (!b.published ? 'not published' : (H.windowOpen(b) ? 'open' : 'closed'))
           : b.status; %>
      <tr>
        <td><a href="/admin/buyers/<%= b.id %>"><%= b.buyer_name %></a> · <span style="color:var(--muted);"><%= b.buyer_email %></span></td>
        <td><%= b.search_areas %> · <%= b.price_range %><% if (!b.in_utah) { %> · from <%= b.origin_state %><% } %></td>
        <td><%= b.window_hours === 168 ? '7 days' : b.window_hours + ' hrs' %></td>
        <td><span class="badge <%= st === 'connected' ? 'connected' : st === 'open' ? 'open' : st === 'closed' ? 'closed' : 'pending' %>"><%= st %></span></td>
        <td><%= b.proposal_count %></td>
        <td><%= new Date(b.created_at).toLocaleDateString('en-US') %></td>
      </tr>
    <% }) %>
  </table>
</div>
<% } %>

</details>

<%# Approved vs Rejected are SEPARATE sections (Paul, Aug 31 §13–§15):
    account status (pending/approved/rejected) and RELD license verification
    stay two different dimensions and are never collapsed into one badge. %>
<details class="sect" open><summary><h2>Approved professionals · <%= agents.length %></h2></summary>
<div class="tblwrap">
  <table class="dt">
    <tr><th>Name</th><th>License</th><th>License verification</th><th>Brokerage</th><th>Account status</th><th>Reviewed</th></tr>
    <% agents.forEach(a => { %>
      <tr>
        <td><a href="/admin/agents/<%= a.user_id %>"><%= a.name %></a> · <%= a.email %></td>
        <td><%= a.license_number %><% if (a.license_state && a.license_state !== 'UT') { %> (<%= a.license_state %>)<% } %></td>
        <td><span class="badge <%= VB[a.verification_status] || 'pending' %>"><%= VL[a.verification_status] || a.verification_status %></span><% if (a.name_mismatch && a.verification_status === 'needs_review') { %><br><span class="meta" style="color:#B45309;">name differs</span><% } else if (a.review_resolved_at) { %><br><span class="meta" style="color:var(--good);">identity confirmed</span><% } %></td>
        <td><%= a.brokerage %></td>
        <td><span class="badge <%= a.status %>"><%= a.status %></span></td>
        <td><%= a.reviewed_at ? new Date(a.reviewed_at).toLocaleDateString('en-US') : '' %><% if (a.reviewed_by === 'RELD auto-verification') { %><br><span class="meta">RELD Auto Verification</span><% } %></td>
      </tr>
    <% }) %>
  </table>
</div>
</details>

<details class="sect"><summary><h2>Rejected professionals<% if (rejected.length) { %> · <%= rejected.length %><% } %></h2></summary>
<% if (rejected.length === 0) { %>
  <div class="card"><p class="sub">No rejected registrations.</p></div>
<% } else { %>
<div class="tblwrap">
  <table class="dt">
    <tr><th>Name / Email</th><th>License</th><th>License verification</th><th>Brokerage</th><th>Registered</th><th>Rejected</th><th>Reason</th></tr>
    <% rejected.forEach(a => { %>
      <tr>
        <td><a href="/admin/agents/<%= a.user_id %>"><%= a.name %></a><br><span class="meta"><%= a.email %></span></td>
        <td><%= a.license_number %><% if (a.license_state && a.license_state !== 'UT') { %> (<%= a.license_state %>)<% } %></td>
        <td><span class="badge <%= VB[a.verification_status] || 'pending' %>"><%= VL[a.verification_status] || a.verification_status %></span></td>
        <td><%= a.brokerage %></td>
        <td><%= new Date(a.registered_at).toLocaleDateString('en-US') %></td>
        <td><%= a.reviewed_at ? new Date(a.reviewed_at).toLocaleDateString('en-US') : '' %><% if (a.reviewed_by === 'RELD auto-verification') { %><br><span class="meta">RELD Auto Verification</span><% } %></td>
        <td class="meta"><%= a.rejection_reason || '—' %></td>
      </tr>
    <% }) %>
  </table>
</div>
<p class="note">Rejected accounts are never deleted — open any record to review its full history. Keeping suspicious or fraudulent registrations on file is deliberate.</p>
<% } %>
</details>

<details class="sect"><summary><h2>License verification (RELD)</h2></summary>
<div class="card">
  <% if (!reldConfigured) { %>
    <p class="sub"><b>Not configured yet.</b> Add <code>RELD_API_KEY</code> (and optionally <code>RELD_API_BASE_URL</code>) as environment variables in Render, then redeploy. Until then, no RELD calls are ever made — signups simply stay "Not yet checked".</p>
  <% } else { %>
    <p class="sub"><b style="color:var(--good);">✓ Configured.</b> RELD is called only on deliberate events: a new professional signup, the Recheck button on a professional's detail page, and the two actions below. Nothing runs on page loads or on a schedule.</p>
  <% } %>

  <h3 style="font-size:15px; margin:16px 0 4px;">Test the connection</h3>
  <p class="note" style="margin-top:2px;">Looks up one license and shows RELD's raw response so you can confirm the field mapping. Uses one lookup; changes nothing in the database.</p>
  <form method="POST" action="/admin/reld-test" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div><label for="reld_state" style="font-size:13px;">State</label><input type="text" id="reld_state" name="state" value="UT" maxlength="2" style="width:70px;"></div>
    <div style="flex:1; min-width:180px;"><label for="reld_num" style="font-size:13px;">License number</label><input type="text" id="reld_num" name="license_number" placeholder="e.g. 9876543-SA00"></div>
    <button class="btn sm" type="submit" <%= reldConfigured ? '' : 'disabled' %>>Test RELD connection</button>
  </form>

  <h3 style="font-size:15px; margin:20px 0 4px;">License audit (batch)</h3>
  <p class="note" style="margin-top:2px;">Verifies every professional with a license on file through RELD's batch endpoint — up to 100 licenses per call, split automatically when there are more. Each professional's status is updated individually; an outage or API error never downgrades anyone. You'll get a summary: Verified | Failed verification | API errors | Skipped.</p>
  <form method="POST" action="/admin/reld-audit" onsubmit="return confirm('Run the RELD audit now? This calls RELD in batches of up to 100 licenses and updates each professional\'s verification status.');">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn sm" type="submit" <%= reldConfigured ? '' : 'disabled' %>>Run RELD audit</button>
  </form>

  <h3 style="font-size:15px; margin:20px 0 4px;">Remove never-verified (test) accounts</h3>
  <p class="note" style="margin-top:2px;">Lists professional accounts that have never passed RELD verification and lets you delete them after two confirmations. Anyone who was ever verified — even if a later check failed or RELD was down — is protected and never listed.</p>
  <a class="btn sm ghost" href="/admin/reld-cleanup">Review never-verified accounts</a>
</div>
</details>

<%# Payments & revenue summary (Paul, Sep 25 §7/§10). Same numbers as the
    full report page — both come from paymentReport(). %>
<details class="sect" id="payments" <%= pay.flagged.length ? 'open' : '' %>><summary><h2>Payments &amp; revenue<% if (pay.flagged.length) { %> · <span style="color:#B42318;"><%= pay.flagged.length %> needs review</span><% } %></h2></summary>
<div class="card">
  <% const usd = (c) => '$' + ((Number(c) || 0) / 100).toFixed(2); %>
  <% if (!paymentsEnabled) { %>
    <p class="sub"><b>Payments are not enabled.</b> Professionals see the credit packages with a "Coming soon" badge and cannot buy anything. To turn purchasing on, add the Stripe environment variables in Render (see README → Payments) and set <code>PAYMENTS_PROVIDER=stripe</code>, then redeploy. Start with Stripe <b>test</b> keys.</p>
  <% } else { %>
    <p class="sub"><b style="color:var(--good);">✓ Purchasing is on.</b> Credits are granted only after the processor confirms payment (webhook first, server-verified return as backup) — never on a page load.</p>
  <% } %>
  <div class="stats" style="margin-top:12px;">
    <div class="stat"><b><%= pay.totals.purchases %></b><span>Purchases</span></div>
    <div class="stat"><b><%= pay.totals.credits %></b><span>Credits sold</span></div>
    <div class="stat"><b><%= usd(pay.totals.gross) %></b><span>Gross revenue</span></div>
    <div class="stat"><b><%= usd(pay.totals.gross_this_month) %></b><span>Gross this month</span></div>
    <div class="stat"><b><%= usd(pay.totals.refunds) %></b><span>Refunded</span></div>
    <div class="stat"><b><%= usd(pay.totals.net) %></b><span>Net after fees &amp; refunds</span></div>
  </div>
  <% if (pay.flagged.length) { %>
    <p class="note" style="color:#B42318; margin-top:10px;"><b>⚠ <%= pay.flagged.length %> refund<%= pay.flagged.length === 1 ? '' : 's' %> need<%= pay.flagged.length === 1 ? 's' : '' %> review</b> — a refund arrived for credits that were already used, so the credits could not all be reversed. Open the report to see who and decide.</p>
  <% } %>
  <p style="margin:12px 0 0;"><a class="btn sm" href="/admin/payments">Open full payments report</a> <a class="btn sm ghost" href="/admin/payments.csv">Download CSV</a></p>
</div>
</details>
<%- include('../partials/foot') %>
