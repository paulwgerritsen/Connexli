<%- include('../partials/head') %>
<h1>Pilot control room</h1>
<p class="sub">Approve professionals, watch marketplace health, keep the promise: verified pros only. · <a href="/admin/analytics">Marketplace analytics ›</a></p>

<div class="stats">
  <div class="stat"><b><%= m.sellers %></b><span>Homeowners</span></div>
  <div class="stat"><b><%= m.approved_agents %></b><span>Verified professionals</span></div>
  <div class="stat"><b><%= m.pending_agents %></b><span>Pending approvals</span></div>
  <div class="stat"><b><%= m.open_requests %></b><span>Open opportunities</span></div>
  <div class="stat"><b><%= m.completed_requests %></b><span>Completed opportunities</span></div>
  <div class="stat"><b><%= m.total_proposals %></b><span>Proposals submitted</span></div>
  <div class="stat"><b><%= m.connected_requests %></b><span>Homeowner selections</span></div>
  <div class="stat"><b><%= m.avg_proposals %></b><span>Avg proposals per opportunity</span></div>
  <div class="stat"><b><%= m.active_buyers %></b><span>Live buyer profiles</span></div>
  <div class="stat"><b><%= m.exploring_buyers %></b><span>Buyers getting ready</span></div>
  <div class="stat"><b><%= m.buyer_proposals %></b><span>Buyer proposals</span></div>
  <div class="stat"><b><%= m.buyer_connections %></b><span>Buyer connections</span></div>
</div>

<details class="sect" open><summary><h2>Verification queue<% if (pending.length) { %> · <%= pending.length %> waiting<% } %></h2></summary>
<% if (pending.length === 0) { %>
  <div class="card"><p class="sub">No professionals waiting for review. 🎉</p></div>
<% } else { %>
  <div class="card">
    <% pending.forEach(a => { %>
      <div class="rowline">
        <div>
          <a href="/admin/agents/<%= a.user_id %>" style="font-weight:700; color:var(--navy);"><%= a.name %></a> <span class="meta">· <%= a.email %><% if (a.phone) { %> · <%= a.phone %><% } %></span>
          <div class="meta">License <b><%= a.license_number %></b> · <%= a.brokerage %> · <%= a.state %><% if (a.service_zip) { %> · Serves <%= a.service_zip %><%= a.service_city ? ' (' + a.service_city + ')' : '' %><% } %> · applied <%= new Date(a.created_at).toLocaleDateString('en-US') %></div>
          <div class="meta"><a href="https://secure.utah.gov/llv/search/index.html" target="_blank" rel="noopener">Check license in the Utah license lookup ↗</a> (verify: active status, name matches, brokerage matches)</div>
        </div>
        <div class="actions">
          <form method="POST" action="/admin/agents/<%= a.user_id %>/approve">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn sm" type="submit">Approve</button>
          </form>
          <form method="POST" action="/admin/agents/<%= a.user_id %>/reject" onsubmit="return confirm('Reject this professional? They will be told verification was unsuccessful.');">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn danger sm" type="submit">Reject</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

</details>

<details class="sect" open><summary><h2>Seller requests · <%= requests.length %></h2></summary>
<div class="tblwrap">
  <table class="dt">
    <tr><th>Request</th><th>Seller</th><th>Window</th><th>Status</th><th>Proposals</th><th>Created</th></tr>
    <% requests.forEach(r => { %>
      <tr>
        <td><a href="/admin/requests/<%= r.id %>"><%= r.property_type %> · <%= r.city %> <%= r.zip %></a> · <%= r.price_range %></td>
        <td><%= r.seller_name %></td>
        <td><%= r.window_hours === 168 ? '7 days' : r.window_hours + ' hrs' %></td>
        <td><span class="badge <%= r.status %>"><%= r.status %></span></td>
        <td><%= r.proposal_count %></td>
        <td><%= new Date(r.created_at).toLocaleDateString('en-US') %></td>
      </tr>
    <% }) %>
  </table>
</div>

</details>

<details class="sect" open><summary><h2>Buyer requests · <%= buyers.length %></h2></summary>
<% if (buyers.length === 0) { %>
  <div class="card"><p class="sub">No buyer profiles yet. They'll appear here as buyers use Find Your Buyer's Agent.</p></div>
<% } else { %>
<div class="tblwrap">
  <table class="dt">
    <%# Mirrors the Seller requests table (Paul, Aug 21): same column order,
        same status vocabulary (open/closed/connected), plain proposal count.
        The status is DERIVED from the request's actual state, not relabeled:
        open = window still accepting proposals, closed = window ended and
        the buyer is deciding, connected = professional selected. %>
    <tr><th>Buyer</th><th>Search</th><th>Window</th><th>Status</th><th>Proposals</th><th>Created</th></tr>
    <% buyers.forEach(b => { %>
      <% const st = b.status === 'connected' ? 'connected'
           : b.status === 'active' ? (!b.published ? 'not published' : (H.windowOpen(b) ? 'open' : 'closed'))
           : b.status; %>
      <tr>
        <td><a href="/admin/buyers/<%= b.id %>"><%= b.buyer_name %></a> · <span style="color:var(--muted);"><%= b.buyer_email %></span></td>
        <td><%= b.search_areas %> · <%= b.price_range %><% if (!b.in_utah) { %> · from <%= b.origin_state %><% } %></td>
        <td><%= b.window_hours === 168 ? '7 days' : b.window_hours + ' hrs' %></td>
        <td><span class="badge <%= st === 'connected' ? 'connected' : st === 'open' ? 'open' : st === 'closed' ? 'closed' : 'pending' %>"><%= st %></span></td>
        <td><%= b.proposal_count %></td>
        <td><%= new Date(b.created_at).toLocaleDateString('en-US') %></td>
      </tr>
    <% }) %>
  </table>
</div>
<% } %>

</details>

<details class="sect" open><summary><h2>Reviewed professionals · <%= agents.length %></h2></summary>
<div class="tblwrap">
  <table class="dt">
    <tr><th>Name</th><th>License</th><th>Brokerage</th><th>Status</th><th>Reviewed</th></tr>
    <% agents.forEach(a => { %>
      <tr>
        <td><a href="/admin/agents/<%= a.user_id %>"><%= a.name %></a> · <%= a.email %></td>
        <td><%= a.license_number %></td>
        <td><%= a.brokerage %></td>
        <td><span class="badge <%= a.status %>"><%= a.status %></span></td>
        <td><%= a.reviewed_at ? new Date(a.reviewed_at).toLocaleDateString('en-US') : '' %></td>
      </tr>
    <% }) %>
  </table>
</div>
</details>
<%- include('../partials/foot') %>
