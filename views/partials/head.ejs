<% } %>
</head>
<body>
<header>
  <div class="nav">
    <%# Logged out, the logo leads back to the marketing site; logged in, it
        leads to your dashboard. %>
    <a class="brand" href="<%= user ? '/' : 'https://connexli.com' %>">
      <img src="/logo.png" alt="" height="22" style="display:block;">
      <span class="wordmark">connex<span>li</span></span>
    </a>
    <div class="nav-right">
      <% if (user) { %>
        <a href="https://connexli.com" class="homelink" style="color:#B9C8DE;"><span class="hl-full">connexli.com</span><span class="hl-short">Home</span></a>
        <span class="who"><%= user.name %><% if (user.role === 'admin') { %> · Admin<% } %></span>
        <% if (user.role === 'seller') { %><a href="/requests/new" style="color:#fff; font-weight:600; text-decoration:none;">+ New <span class="hl-full">request</span></a><% } %>
        <% if (user.role === 'seller') { %><a href="/settings" style="color:#B9C8DE;">Settings</a><% } else if (user.role === 'agent') { %><a href="/agent/settings" style="color:#B9C8DE;">Settings</a><% } %>
        <form method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="linkbtn" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a href="https://connexli.com" class="homelink" style="color:#B9C8DE;">‹ <span class="hl-full">Back to connexli.com</span><span class="hl-short">Home</span></a>
        <a href="/login" style="color:#B9C8DE;">Log in</a>
        <a href="/register" style="color:#fff; font-weight:600;">Create account</a>
      <% } %>
    </div>
  </div>
</header>
<main class="wrap">
