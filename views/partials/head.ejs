<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> · Connexli</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" href="/logo.png">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header>
  <div class="nav">
    <a class="brand" href="/">
      <img src="/logo.png" alt="" height="22" style="display:block;">
      <span class="wordmark">connex<span>li</span></span>
    </a>
    <div class="nav-right">
      <% if (user) { %>
        <span class="who"><%= user.name %><% if (user.role === 'admin') { %> · Admin<% } %></span>
        <% if (user.role === 'seller') { %><a href="/requests/new" style="color:#fff; font-weight:600; text-decoration:none;">+ New request</a><% } %>
        <form method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="linkbtn" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a href="/login" style="color:#B9C8DE;">Log in</a>
        <a href="/register" style="color:#fff; font-weight:600;">Create account</a>
      <% } %>
    </div>
  </div>
</header>
<main class="wrap">
