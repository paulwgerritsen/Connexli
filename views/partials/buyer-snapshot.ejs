<%# The anonymous Buyer Snapshot as a professional sees it when evaluating a
    buyer opportunity. Shared by the live buyer opportunity page and the
    practice buyer opportunity (Sep 30). Local: buyer (a buyer_profiles row). %>
<div class="card" data-buyer-snapshot>
  <div class="sumrow"><span>Financing</span><span><b><%= buyer.financing_type %></b> · <%= buyer.lender_status %> · <%= buyer.down_payment %> down</span></div>
  <div class="sumrow"><span>Price range & purpose</span><span><%= buyer.price_range %> · <%= buyer.purchase_purpose %></span></div>
  <div class="sumrow"><span>Timeline</span><span><%= buyer.timeline %></span></div>
  <% if (buyer.expected_tours) { %><div class="sumrow"><span>Expected home tours</span><span><%= buyer.expected_tours %> <span class="hint">(buyer's estimate — not a limit on showings)</span></span></div><% } %>
  <div class="sumrow"><span>Search areas</span><span><%= buyer.search_areas %></span></div>
  <div class="sumrow"><span>Current home</span><span><%= buyer.current_situation %><%= buyer.need_to_sell !== 'No' ? ' · Must sell first (' + buyer.need_to_sell.replace('Yes — ','') + ')' : '' %></span></div>
  <% if (!buyer.in_utah) { %><div class="sumrow"><span>Relocation</span><span>From <%= buyer.origin_state %><%= buyer.move_reason ? ' · ' + buyer.move_reason : '' %><%= buyer.visit_dates ? ' · visiting ' + buyer.visit_dates : '' %></span></div><% } %>
  <% if (buyer.video_tours) { %><div class="sumrow"><span>Video tours</span><span>Yes — this buyer would like video / virtual tours</span></div><% } %>
  <% if (buyer.property_prefs) { %><div class="sumrow"><span>Looking for</span><span><%= buyer.property_prefs %></span></div><% } %>
  <% if (buyer.priorities) { %><div class="sumrow"><span>Top priorities</span><span><%= buyer.priorities %></span></div><% } %>
  <% if (buyer.availability) { %><div class="sumrow"><span>Tour availability</span><span><%= buyer.availability %></span></div><% } %>
  <% if (buyer.first_time === true) { %><div class="sumrow"><span>First-time buyer</span><span>Yes</span></div><% } %>
  <% if (buyer.notes) { %><div class="sumrow"><span>In their words</span><span><%= buyer.notes %></span></div><% } %>
</div>
