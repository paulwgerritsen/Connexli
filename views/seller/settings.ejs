<%- include('../partials/head') %>
<div class="narrow">
  <a href="/dashboard" style="font-size:14px;">‹ Back to my dashboard</a>
  <h1 style="margin-top:8px;">Account settings</h1>
  <p class="sub">Your contact details stay private until you choose to connect with a professional.</p>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (saved) { %><div class="notice" style="background:#EAF7EE; border:1px solid #BFE5CB; color:#1E6B37; border-radius:10px; padding:12px 16px; margin-bottom:16px; font-size:14.5px;">Your settings have been saved.</div><% } %>

  <form method="POST" action="/settings">
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <div class="card">
      <h2 style="font-size:16px;">Contact information</h2>
      <p class="note" style="margin-top:2px;">Released only to a professional you select to connect with.</p>
      <label for="name">Full name</label>
      <input type="text" id="name" name="name" value="<%= p.name %>" required>
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" value="<%= p.email %>" autocomplete="email" required>
      <label for="phone">Phone (optional)</label>
      <input type="tel" id="phone" name="phone" value="<%= p.phone || '' %>" autocomplete="tel">
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Email notifications</h2>
      <label style="display:flex; gap:10px; align-items:flex-start; cursor:pointer; margin-top:6px;">
        <input type="checkbox" name="email_notifications" <%= p.email_notifications === false ? '' : 'checked' %> style="margin-top:4px; width:16px; height:16px; flex:none; accent-color:var(--blue);">
        <span style="font-size:14px; color:var(--muted); line-height:1.5; font-weight:400;"><b style="color:var(--navy);">Email me about my requests</b><br>
        Updates like "your proposals are ready to compare." Turning this off only stops the emails — everything still appears on your dashboard, and password-reset emails always send.</span>
      </label>
    </div>

    <button class="btn full" type="submit">Save settings</button>
  </form>
</div>
<%- include('../partials/foot') %>
