<%- include('../partials/head') %>
<a href="/dashboard" style="font-size:14px;">‹ Back to my requests</a>
<% const connectedProposal = proposals.find(p => p.connected); %>

<% if (request.status === 'connected' && connectedProposal) { %>
  <div class="narrow" style="max-width:640px;">
    <h1>You're connected 🎉</h1>
    <p class="sub"><%= connectedProposal.agent_name %> has received your contact information and will reach out soon. You can also reach them directly:</p>
    <div class="card">
      <div class="sumrow"><span>Professional</span><span><%= connectedProposal.agent_name %></span></div>
      <div class="sumrow"><span>Brokerage</span><span><%= connectedProposal.brokerage %></span></div>
      <div class="sumrow"><span>License</span><span><%= connectedProposal.license_number %></span></div>
      <div class="sumrow"><span>Email</span><span><%= connectedProposal.agent_email %></span></div>
      <% if (connectedProposal.agent_phone) { %><div class="sumrow"><span>Phone</span><span><%= connectedProposal.agent_phone %></span></div><% } %>
      <div class="sumrow"><span>Their proposal</span><span><%= H.feeLabel(connectedProposal) %> (est. <%= H.money(H.estFee(connectedProposal, request.price_range)) %>)</span></div>
    </div>
    <div class="success">Their Connexli proposal is saved above for your reference. The listing agreement is signed directly with the brokerage, outside Connexli. Still no obligation.</div>
    <p style="margin-top:16px;"><a class="btn ghost" href="/dashboard">Back to my requests</a></p>
  </div>
<% } else { %>
  <h1>Your proposals are ready 🎉</h1>
  <p class="sub"><b style="color:var(--blue);"><%= proposals.length %></b> verified professional<%= proposals.length === 1 ? '' : 's' %> responded to your <%= request.property_type.toLowerCase() %> in <%= request.city %><% if (request.round > 1) { %> across <%= request.round %> rounds<% } %>. Estimated fees assume a sale near the middle of your range (<b><%= H.money(H.midPrice(request.price_range)) %></b>).</p>
  <p class="note">ⓘ Each fee shown is that professional's proposed <b>listing-side</b> compensation — for representing you as the seller. Compensation involving a buyer's agent, if any, is separate: discuss your options with the professional you select. Connexli does not set or recommend commissions.</p>

  <% if (proposals.length === 0) { %>
    <div class="card" style="text-align:center; padding:34px 20px;">
      <h2>No proposals this time</h2>
      <p class="sub">This can happen in a brand-new market. Our team has been notified and will personally reach out to professionals in your area. You can also create a new request with a longer window.</p>
      <p style="margin-top:14px;"><a class="btn" href="/requests/new">Create a new request</a></p>
    </div>
  <% } else { %>
    <div style="display:flex; gap:10px; align-items:center; margin-top:14px; flex-wrap:wrap;">
      <form method="GET" action="/requests/<%= request.id %>" style="display:flex; gap:8px; align-items:center;">
        <label style="margin:0;" for="sort">Sort by</label>
        <select id="sort" name="sort" onchange="this.form.submit()" style="width:auto; padding:8px 10px;">
          <option value="fee" <%= sort === 'fee' ? 'selected' : '' %>>Lowest estimated fee</option>
          <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
        </select>
      </form>
      <a class="btn navy sm" href="/requests/<%= request.id %>/compare">Compare side by side</a>
    </div>

    <div class="cards">
      <% proposals.forEach(p => { %>
        <div class="card pcard">
          <div class="grow">
            <div class="agent-top">
              <div class="avatar"><%= p.agent_name.split(' ').map(w => w[0]).join('').slice(0,2).toUpperCase() %></div>
              <div><b><%= p.agent_name %></b><span class="brok"><%= p.brokerage %> · <span style="color:var(--good); font-weight:600;">✓ Verified</span></span></div>
            </div>
            <% if (p.transactions_seller_12mo !== null || p.transactions_buyer_12mo !== null) { %>
              <p class="note" style="margin-top:6px;"><b>Last 12 months:</b> <%= p.transactions_seller_12mo ?? 0 %> seller-side · <%= p.transactions_buyer_12mo ?? 0 %> buyer-side transactions <span style="color:var(--muted);">(reported by the professional)</span></p>
            <% } %>
            <div class="complbl">Proposed listing-side compensation ⓘ</div>
            <div><span class="fee"><%= H.feeLabel(p) %></span> <span class="est">Est. fee: <%= H.money(H.estFee(p, request.price_range)) %></span></div>
            <% if (p.services) { %><div class="pillrow"><% p.services.split(', ').forEach(s => { %><span class="pill"><%= s %></span><% }) %></div><% } %>
            <% if (p.marketing_plan) { %><p class="note" style="margin-top:9px;"><b>Marketing plan:</b> <%= p.marketing_plan %></p><% } %>
            <p class="note"><b>Cancellation:</b> <%= p.cancellation_terms %></p>
          </div>
          <div class="cardbtns">
            <form method="POST" action="/requests/<%= request.id %>/shortlist/<%= p.id %>">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn ghost <%= p.shortlisted ? 'on' : '' %>" type="submit"><%= p.shortlisted ? '✓ Shortlisted' : '☆ Shortlist' %></button>
            </form>
            <form method="POST" action="/requests/<%= request.id %>/connect/<%= p.id %>" onsubmit="return confirm('Release your name, email, and phone number to <%= p.agent_name %>? Only this professional receives your details.\n\nNote: choosing an agent may lead to a separate written listing agreement — review the compensation terms, including any buyer-agent compensation you authorize, before signing.');">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn" type="submit">Connect</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
    <p class="note">Connecting releases your contact info to that one professional only. The listing agreement is signed with their brokerage, outside Connexli. No obligation.</p>
  <% } %>

  <% if (request.status === 'closed' && !request.extended && proposals.length < request.proposal_cap) { %>
    <div class="card" style="border-left:4px solid var(--blue); margin-top:18px;">
      <h2 style="font-size:16px;">Your window ended with <%= proposals.length %> proposal<%= proposals.length === 1 ? '' : 's' %> — want to keep it open?</h2>
      <p class="sub" style="margin-bottom:10px;">Keep this same request open for an additional <b>24 hours</b> — professionals who already proposed stay in, and new ones can still join until the extension ends or all <%= request.proposal_cap %> spots fill. Available once per request.</p>
      <form method="POST" action="/requests/<%= request.id %>/extend">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn" type="submit">Keep request open for 24 more hours</button>
      </form>
    </div>
  <% } %>

  <% if (request.status === 'closed') { %>
    <% const roundFull = proposals.length >= request.proposal_cap; %>
    <div class="card" style="border-left:4px solid var(--blue); margin-top:18px;">
      <h2 style="font-size:16px;">Want more options?</h2>
      <p class="sub" style="margin-bottom:10px;">Open another round: your request goes live again for <%= request.window_hours >= 24 ? (request.window_hours / 24) + ' day' + (request.window_hours > 24 ? 's' : '') : request.window_hours + ' hours' %> and up to 10 more verified professionals can propose — only agents who <b>haven't</b> proposed yet will see it. Every proposal you already have stays right here.</p>
      <% if (roundFull) { %>
        <form method="POST" action="/requests/<%= request.id %>/rebid" onsubmit="return confirm('Open a new proposal round? Up to 10 additional professionals (who haven\'t proposed yet) will be invited, and your current proposals remain saved.');">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn ghost" type="submit">Request another round of proposals</button>
        </form>
      <% } else { %>
        <button class="btn ghost" type="button" disabled style="opacity:.45; cursor:not-allowed;">Request another round of proposals</button>
        <p class="note" style="margin-top:8px;">Another round becomes available after all <%= request.proposal_cap %> proposal spots have been filled.<% if (!request.extended) { %> Until then, the 24-hour extension above gives more professionals time to propose.<% } %></p>
      <% } %>
    </div>
  <% } %>
<% } %>
<%- include('../partials/foot') %>
