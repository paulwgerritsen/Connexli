<%- include('../partials/head') %>
<%# sample = practice mode (Sep 30): the SAME form a homeowner fills out,
    shown read-only to a professional with the fictional practice answers.
    Nothing here can be submitted in that mode. %>
<% const S = typeof sample !== 'undefined' && sample; %>
<%# preview = public "See what Connexli asks" mode (Oct 1): the SAME form,
    fully clickable, for visitors with no account. It has no submit action —
    nothing is sent or saved — and ends with a "Create a Selling Request" card. %>
<% const P = typeof preview !== 'undefined' && preview; %>
<div class="narrow" style="max-width:640px;">
  <% if (S) { %>
    <a href="/agent/practice/seller" style="font-size:14px;">‹ Back to the practice opportunity</a>
    <%- include('../partials/practice-banner', { practiceKind: 'seller' }) %>
    <div class="card" style="border-left:4px solid var(--blue); padding:14px 18px;" data-sample-request="seller">
      <b style="color:var(--navy);">See what the seller submitted</b>
      <span class="sub" style="display:inline;">Below is the exact form a homeowner completes on Connexli, filled in with this practice request's fictional answers (read-only). This is everything Connexli collects about the home before an opportunity reaches you — no address, name, or contact details.</span>
    </div>
  <% } else if (P) { %>
    <a href="https://connexli.com/selling.html" style="font-size:14px;">‹ Back to connexli.com</a>
    <%- include('../partials/preview-banner', { previewKind: 'selling' }) %>
  <% } else { %>
  <a href="/dashboard" style="font-size:14px;">‹ Back to my requests</a>
  <% } %>
  <h1 style="margin-top:8px;">Tell us about the home you may sell</h1>
  <p class="sub">Professionals see only a general opportunity. Your address and contact info are hidden until you choose to share them.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <form <% if (S) { %>onsubmit="return false;" aria-label="Sample seller request (read-only)"<% } else if (P) { %>onsubmit="return false;" id="previewForm" aria-label="Selling request preview — nothing is submitted"<% } else { %>method="POST" action="/requests/new"<% } %>>
    <% if (!P) { %><input type="hidden" name="_csrf" value="<%= csrf %>"><% } %>
    <fieldset <%= S ? 'disabled' : '' %> style="border:0; padding:0; margin:0; min-width:0;">

    <div class="card">
      <h2>The property</h2>
      <label>What are you selling?</label>
      <div class="optgrid cols">
        <% H.PROPERTY_TYPES.forEach(t => { %>
          <label class="opt"><input type="radio" name="property_type" value="<%= t %>" <%= form.property_type === t ? 'checked' : '' %> required>
          <span class="tile"><b><%= t %></b></span></label>
        <% }) %>
      </div>
      <div class="grid2">
        <div><label for="zip">ZIP code</label><input type="text" id="zip" name="zip" inputmode="numeric" pattern="\d{5}" value="<%= form.zip || '' %>" required></div>
        <div><label for="city">City</label><input type="text" id="city" name="city" value="<%= form.city || '' %>" required></div>
      </div>
      <label for="neighborhood">Approximate neighborhood <span class="hint">(optional — address stays private)</span></label>
      <input type="text" id="neighborhood" name="neighborhood" value="<%= form.neighborhood || '' %>">
      <div class="grid2">
        <div><label for="beds">Bedrooms</label><select id="beds" name="beds"><% H.BEDS.forEach(v => { %><option <%= form.beds === v ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
        <div><label for="baths">Bathrooms</label><select id="baths" name="baths"><% H.BATHS.forEach(v => { %><option <%= form.baths === v ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
        <div><label for="sqft_range">Square feet</label><select id="sqft_range" name="sqft_range"><% H.SQFT.forEach(v => { %><option <%= (form.sqft_range || '2,500–3,000') === v ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
        <div><label for="year_built">Year built</label><select id="year_built" name="year_built"><% H.YEARS.forEach(v => { %><option <%= (form.year_built || '2000–2009') === v ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
        <div><label for="hoa">HOA</label><select id="hoa" name="hoa"><option <%= form.hoa === 'No' ? 'selected' : '' %>>No</option><option <%= form.hoa === 'Yes' ? 'selected' : '' %>>Yes</option></select></div>
        <div><label for="condition">Condition</label><select id="condition" name="condition"><% H.CONDITIONS.forEach(v => { %><option <%= (form.condition || 'Updated') === v ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
      </div>
      <label for="price_range">Desired price range</label>
      <select id="price_range" name="price_range" required>
        <option value="" disabled <%= form.price_range ? '' : 'selected' %>>Choose a range</option>
        <% Object.keys(H.PRICE_RANGES).forEach(v => { %><option <%= form.price_range === v ? 'selected' : '' %>><%= v %></option><% }) %>
      </select>
      <%# Listing timeline (Paul, Sep 30): same wording style and time buckets
          as the buyer's "When do you want to buy?" question. %>
      <label for="listing_timeline">When are you hoping to list your home?</label>
      <select id="listing_timeline" name="listing_timeline" required>
        <option value="" disabled <%= form.listing_timeline ? '' : 'selected' %>>Choose one…</option>
        <% H.SELLER_TIMELINE.forEach(v => { %><option <%= form.listing_timeline === v ? 'selected' : '' %>><%= v %></option><% }) %>
      </select>
    </div>

    <%# One standard rule replaces the old window choice (Paul, Sep 30): up to
        48 hours OR 10 proposals, whichever comes first. Nothing to choose. %>
    <div class="card" id="get-proposals">
      <h2>Get your proposals</h2>
      <p class="sub" style="margin-bottom:0;">Professionals have up to 48 hours to respond. You'll receive up to 10 proposals to compare. If all 10 spots fill sooner, your proposals will be ready right away.</p>
      <p class="note" style="margin-top:8px;">Proposals stay private until then — you'll see them all together, side by side. Want more after that? You can get 10 more proposals on the same request.</p>
      <div class="card" style="border-left:4px solid var(--blue); margin-top:18px; padding:16px 18px;">
        <h2 style="font-size:15.5px;">Before you request proposals</h2>
        <p class="note" style="margin-top:6px;">Agents will compete on their <b>listing-side fee and services</b> — the compensation for representing <i>you</i>. Any compensation involving a <b>buyer's agent</b> is separate, and is something to discuss with the listing professional you ultimately select. <a href="https://connexli.com/selling.html" target="_blank" rel="noopener">Learn more ›</a></p>
        <label style="display:flex; gap:10px; align-items:flex-start; margin-top:10px; cursor:pointer;">
          <input type="checkbox" name="comp_ack" value="yes" required style="margin-top:4px; width:16px; height:16px; flex:none; accent-color:var(--blue);" <%= form.comp_ack === 'yes' ? 'checked' : '' %>>
          <span style="font-size:13.5px; color:var(--muted); line-height:1.5; font-weight:400;">I understand that Connexli listing proposals show the listing professional's proposed compensation and do not necessarily represent every cost associated with a future sale.</span>
        </label>
      </div>
      <% if (S) { %>
        <p class="note" style="margin-top:18px;">(The homeowner taps <b>Launch my request</b> here. Verified professionals nearby are then notified — that's when the opportunity reaches you.)</p>
      <% } else if (P) { %>
        <p class="note" style="margin-top:18px;">That's everything Connexli asks. In a real request, the next tap is <b>Launch my request</b> — in this preview there is nothing to submit.</p>
      <% } else { %>
      <button class="btn full" type="submit" style="margin-top:18px;">Launch my request</button>
      <% } %>
      <p class="note">Free for homeowners. No obligation at any point. Connexli does not set or recommend commissions.</p>
    </div>
    </fieldset>
  </form>
  <% if (S) { %>
    <a class="btn full" href="/agent/practice/seller" style="margin-top:6px;">Back to the practice opportunity</a>
  <% } %>
  <% if (P) { %>
    <%- include('../partials/preview-cta', { previewKind: 'selling' }) %>
    <p class="note" style="text-align:center;">Buying too? <a href="/preview/buying">Preview the buying request ›</a></p>
  <% } %>
</div>
<%- include('../partials/foot') %>
