<%- include('../partials/head') %>
<%# sample = practice mode (Sep 30): step 2 of what a buyer fills out, shown
    read-only to a professional with the fictional practice answers. %>
<% const S = typeof sample !== 'undefined' && sample; %>
<%# preview = public request preview (Oct 1): clickable, nothing submitted. %>
<% const P = typeof preview !== 'undefined' && preview; %>
<div class="narrow" style="max-width:640px;">
  <% if (S) { %>
    <a href="/agent/practice/buyer/request" style="font-size:14px;">‹ Back to step 1 of what the buyer submitted</a>
    <%- include('../partials/practice-banner', { practiceKind: 'buyer' }) %>
    <div class="card" style="border-left:4px solid var(--blue); padding:14px 18px;" data-sample-request="buyer-boost">
      <b style="color:var(--navy);">See what the buyer submitted — step 2 (optional)</b>
      <span class="sub" style="display:inline;">After publishing, buyers can add these optional details. This practice buyer did — the answers appear in the Buyer Snapshot you evaluate.</span>
    </div>
  <% } else if (P) { %>
    <a href="/preview/buying" style="font-size:14px;">‹ Back to the buying request preview</a>
    <%- include('../partials/preview-banner', { previewKind: 'buying' }) %>
  <% } else { %>
  <a href="/buyer" style="font-size:14px;">‹ Back to my profile</a>
  <% } %>
  <h1 style="margin-top:8px;">Boost your profile</h1>
  <p class="sub">All optional — but every answer makes the proposals you receive more specific. Vague profiles get generic pitches; detailed profiles get real plans.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <form <% if (S) { %>onsubmit="return false;" aria-label="Sample buyer details (read-only)"<% } else if (P) { %>onsubmit="return false;" id="previewForm" aria-label="Buying request preview — nothing is submitted"<% } else { %>method="POST" action="/buyer/boost"<% } %>>
    <% if (!P) { %><input type="hidden" name="_csrf" value="<%= csrf %>"><% } %>
    <fieldset <%= S ? 'disabled' : '' %> style="border:0; padding:0; margin:0; min-width:0;">
    <div class="card">
      <label for="property_prefs">What are you looking for in a home?</label>
      <textarea id="property_prefs" name="property_prefs" rows="3" maxlength="400" placeholder="e.g. Rambler with a finished basement, 3+ beds, 2,500–4,000 sq ft, 2-car garage, newer than 2000"><%= profile.property_prefs %></textarea>
      <label>Your top priorities (choose up to 3)</label>
      <div class="optgrid cols chips">
        <% H.B_PRIORITIES.forEach(p => { %>
          <label class="opt"><input type="checkbox" name="priorities" value="<%= p %>" <%= (profile.priorities || '').includes(p) ? 'checked' : '' %>><span class="tile"><b style="font-weight:500;"><%= p %></b></span></label>
        <% }) %>
      </div>
      <p class="note" id="prioNote">Tap to select — tap again to deselect. Up to 3.</p>
      <label for="availability">When are you generally available for tours?</label>
      <input type="text" id="availability" name="availability" placeholder="e.g. Weeknights after 6 + Saturdays" value="<%= profile.availability %>">
      <label>Is this your first home purchase?</label>
      <div class="optgrid cols keep2">
        <label class="opt"><input type="radio" name="first_time" value="yes" <%= profile.first_time === true ? 'checked' : '' %>><span class="tile"><b>Yes</b></span></label>
        <label class="opt"><input type="radio" name="first_time" value="no" <%= profile.first_time === false ? 'checked' : '' %>><span class="tile"><b>No</b></span></label>
      </div>
      <label for="notes">Anything else agents should know? (optional)</label>
      <textarea id="notes" name="notes" rows="3" maxlength="500"><%= profile.notes %></textarea>
    </div>
    <% if (!S && !P) { %><button class="btn full" type="submit">Save my answers</button><% } %>
    </fieldset>
  </form>
  <% if (S) { %>
    <a class="btn full" href="/agent/practice/buyer">Back to the practice opportunity</a>
  <% } %>
  <% if (P) { %>
    <%- include('../partials/preview-cta', { previewKind: 'buying' }) %>
  <% } %>
</div>
<script>
// Limit priorities to three; a fourth click bounces with a brief note.
var pboxes = document.querySelectorAll('input[name="priorities"]');
pboxes.forEach(function(b){ b.addEventListener('change', function(){
  var checked = document.querySelectorAll('input[name="priorities"]:checked');
  if (checked.length > 3) {
    b.checked = false;
    var n = document.getElementById('prioNote');
    n.textContent = 'That\'s 3 already — deselect one first to swap it.';
    setTimeout(function(){ n.textContent = 'Tap to select — tap again to deselect. Up to 3.'; }, 2500);
  }
});});
</script>
<%- include('../partials/foot') %>
