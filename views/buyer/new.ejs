<%- include('../partials/head') %>
<div class="narrow" style="max-width:640px;">
  <a href="/buyer" style="font-size:14px;">‹ Back</a>
  <h1 style="margin-top:8px;">Your buyer profile</h1>
  <p class="sub">About 2 minutes. Agents see an anonymous snapshot — your name and contact info stay hidden until you choose to connect.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <form method="POST" action="/buyer/new">
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <div class="card">
      <h2 style="font-size:16px;">Your financing</h2>
      <label for="financing_type">How will you pay?</label>
      <select id="financing_type" name="financing_type" required>
        <option value="" disabled <%= !form.financing_type ? 'selected' : '' %>>Choose one…</option>
        <% H.B_FINANCING.forEach(o => { %><option <%= form.financing_type === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <label for="lender_status">Are you working with a lender?</label>
      <select id="lender_status" name="lender_status" required>
        <option value="" disabled <%= !form.lender_status ? 'selected' : '' %>>Choose one…</option>
        <% H.B_LENDER.forEach(o => { %><option <%= form.lender_status === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <p class="note">Prequalified is a quick estimate; preapproved means a lender verified your documents. Agents compete hardest for preapproved buyers.</p>
      <label for="down_payment">Estimated down payment</label>
      <select id="down_payment" name="down_payment" required>
        <option value="" disabled <%= !form.down_payment ? 'selected' : '' %>>Choose one…</option>
        <% H.B_DOWN.forEach(o => { %><option <%= form.down_payment === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Your search</h2>
      <label for="city_input">Cities you're searching <span class="hint">(start typing, pick from the list, add as many as you like)</span></label>
      <div id="cityTags" class="pillrow" style="margin:6px 0;"></div>
      <%# The inline onkeydown guard runs the instant the element parses, so an
          early Enter press can never submit the form before the tag script
          below has attached its listeners. %>
      <input type="text" id="city_input" list="utcities" placeholder="e.g. Lehi — press Enter to add" autocomplete="off"
             onkeydown="if(event.key==='Enter'){event.preventDefault();}">
      <datalist id="utcities">
        <% H.UT_CITIES.forEach(c => { %><option value="<%= c %>"></option><% }) %>
      </datalist>
      <input type="hidden" id="search_areas" name="search_areas" value="<%= form.search_areas || '' %>">
      <p class="note" id="cityNote">Each city is added as a tag — click × to remove it.</p>
      <script>
      (function(){
        var tags = [];
        var hidden = document.getElementById('search_areas');
        var input = document.getElementById('city_input');
        var wrap = document.getElementById('cityTags');
        (hidden.value || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean).forEach(function(c){ tags.push(c); });
        function render(){
          hidden.value = tags.join(', ');
          wrap.innerHTML = tags.map(function(c, i){
            return '<span class="pill" style="cursor:pointer;" data-i="' + i + '">' + c.replace(/</g,'&lt;') + ' ×</span>';
          }).join('');
          wrap.querySelectorAll('.pill').forEach(function(el){
            el.addEventListener('click', function(){ tags.splice(parseInt(el.dataset.i), 1); render(); });
          });
        }
        function add(){
          var v = input.value.replace(/,/g, '').trim();
          if (!v) return;
          if (!tags.some(function(t){ return t.toLowerCase() === v.toLowerCase(); })) tags.push(v);
          input.value = '';
          render();
        }
        input.addEventListener('change', add);            // datalist selection
        input.addEventListener('keydown', function(e){
          if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); add(); }
        });
        input.form && input.form.addEventListener('submit', function(){ add(); });
        render();
        window.__cityTagsReady = true; // marker for automated tests
      })();
      </script>
      <label for="price_range">Price range</label>
      <select id="price_range" name="price_range" required>
        <option value="" disabled <%= !form.price_range ? 'selected' : '' %>>Choose one…</option>
        <% Object.keys(H.PRICE_RANGES).forEach(o => { %><option <%= form.price_range === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <label for="timeline">When do you want to buy?</label>
      <select id="timeline" name="timeline" required>
        <option value="" disabled <%= !form.timeline ? 'selected' : '' %>>Choose one…</option>
        <% H.B_TIMELINE.forEach(o => { %><option <%= form.timeline === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <label for="purchase_purpose">This home will be a…</label>
      <select id="purchase_purpose" name="purchase_purpose">
        <% H.B_PURPOSE.forEach(o => { %><option <%= (form.purchase_purpose || 'Primary residence') === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Your current home</h2>
      <label for="current_situation">Right now you…</label>
      <select id="current_situation" name="current_situation">
        <% H.B_SITUATION.forEach(o => { %><option <%= (form.current_situation || 'Rent') === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <label for="need_to_sell">Do you need to sell a home before buying?</label>
      <select id="need_to_sell" name="need_to_sell">
        <% H.B_SELL_FIRST.forEach(o => { %><option <%= (form.need_to_sell || 'No') === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Where you're located</h2>
      <label>Are you currently in Utah?</label>
      <div class="optgrid cols" style="grid-template-columns:1fr 1fr;">
        <label class="opt"><input type="radio" name="in_utah" value="yes" <%= form.in_utah !== 'no' ? 'checked' : '' %> onchange="document.getElementById('relo').style.display='none'"><span class="tile"><b>Yes</b></span></label>
        <label class="opt"><input type="radio" name="in_utah" value="no" <%= form.in_utah === 'no' ? 'checked' : '' %> onchange="document.getElementById('relo').style.display='block'"><span class="tile"><b>No — I'm relocating</b></span></label>
      </div>
      <div id="relo" style="display:<%= form.in_utah === 'no' ? 'block' : 'none' %>; margin-top:10px;">
        <label for="origin_state">Which state are you moving from?</label>
        <select id="origin_state" name="origin_state">
          <option value="" <%= !form.origin_state ? 'selected' : '' %>>Choose a state…</option>
          <% H.US_STATES.forEach(s => { %><option <%= form.origin_state === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
        <label for="move_reason">Reason for the move (optional)</label>
        <input type="text" id="move_reason" name="move_reason" placeholder="e.g. job, family, lifestyle" value="<%= form.move_reason || '' %>">
        <label for="visit_dates">When do you plan to visit Utah? (optional)</label>
        <input type="text" id="visit_dates" name="visit_dates" placeholder="e.g. Sept 12–15" value="<%= form.visit_dates || '' %>">
      </div>
      <div class="optgrid" style="margin-top:10px;">
        <label class="opt"><input type="checkbox" name="video_tours" value="yes" <%= form.video_tours === 'yes' ? 'checked' : '' %>><span class="tile"><b style="font-weight:600;">I'd like video / virtual tours</b><span class="desc">Helpful if you're relocating, traveling, or just prefer a first look on video.</span></span></label>
      </div>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Choose your proposal window</h2>
      <p class="note" style="margin-top:2px;">Verified buyer's agents compete during this window. Proposals stay sealed until it closes — then you compare everything at once. If all 10 spots fill early, it closes right then and your comparison is ready sooner.</p>
      <div class="optgrid">
        <% H.WINDOWS.forEach(w => { %>
          <label class="opt">
            <input type="radio" name="window_hours" value="<%= w.hours %>" <%= (parseInt(form.window_hours) || 48) === w.hours ? 'checked' : '' %>>
            <span class="tile"><span>
              <% if (w.hours === 48) { %><span class="rec">RECOMMENDED</span><% } %>
              <b><%= w.label %></b>
              <span class="desc"><%= w.desc %></span>
            </span></span>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">One important question</h2>
      <label for="bba">Have you signed a Buyer Broker Agreement with another agent?</label>
      <select id="bba" name="bba">
        <% H.B_BBA.forEach(o => { %><option <%= (form.bba || 'No') === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <label for="bba_expires">If currently active: when does it expire? (optional)</label>
      <input type="text" id="bba_expires" name="bba_expires" placeholder="e.g. October 2026" value="<%= form.bba_expires || '' %>">
      <p class="note">An active exclusive agreement means that agent already represents you — we'll explain what that means on the next screen if it applies.</p>
    </div>

    <button class="btn full" type="submit" style="margin-top:6px;">Publish my buyer profile</button>
    <p class="note" style="text-align:center;">Free · anonymous until you connect · no obligation</p>
  </form>
</div>
<%- include('../partials/foot') %>
