<%- include('../partials/head') %>
<div class="narrow" style="max-width:640px;">
  <%# Straight back to the dashboard (Paul, Aug 16) — never via the previous
      request's connected/success page. %>
  <a href="/dashboard" style="font-size:14px;">‹ Back to my dashboard</a>
  <h1 style="margin-top:8px;">Your buyer profile</h1>
  <p class="sub">About 2 minutes. Agents see an anonymous snapshot — your name and contact info stay hidden until you choose to connect.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <form method="POST" action="/buyer/new">
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <div class="card">
      <h2 style="font-size:16px;">Your financing</h2>
      <label for="financing_type">How will you pay?</label>
      <select id="financing_type" name="financing_type" required>
        <option value="" disabled <%= !form.financing_type ? 'selected' : '' %>>Choose one…</option>
        <% H.B_FINANCING.forEach(o => { %><option <%= form.financing_type === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <label for="lender_status">Are you working with a lender?</label>
      <select id="lender_status" name="lender_status" required>
        <option value="" disabled <%= !form.lender_status ? 'selected' : '' %>>Choose one…</option>
        <% H.B_LENDER.forEach(o => { %><option <%= form.lender_status === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <p class="note">Prequalified is a quick estimate; preapproved means a lender verified your documents. Agents compete hardest for preapproved buyers.</p>
      <label for="down_payment">Estimated down payment</label>
      <select id="down_payment" name="down_payment" required>
        <option value="" disabled <%= !form.down_payment ? 'selected' : '' %>>Choose one…</option>
        <% H.B_DOWN.forEach(o => { %><option <%= form.down_payment === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Your search</h2>
      <label for="city_input">Cities you're searching <span class="hint">(start typing, pick from the list, add as many as you like)</span></label>
      <div id="cityTags" class="pillrow" style="margin:6px 0;"></div>
      <%# Custom autocomplete (Paul, Aug 14 #2). The native <datalist> never
          shows suggestions on iOS Safari and is inconsistent elsewhere, so we
          draw our own dropdown — identical behavior on mobile and desktop.
          Only cities from the standardized Utah list can become tags. The
          inline onkeydown guard runs the instant the element parses, so an
          early Enter press can never submit the form before the script below
          has attached its listeners. %>
      <div style="position:relative;">
        <input type="text" id="city_input" placeholder="Start typing a city, e.g. Lehi" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="citySuggest"
               onkeydown="if(event.key==='Enter'){event.preventDefault();}">
        <div id="citySuggest" role="listbox" style="display:none; position:absolute; z-index:30; left:0; right:0; top:100%; margin-top:4px; background:#fff; border:1px solid #E1E7F0; border-radius:10px; box-shadow:0 8px 24px rgba(10,27,51,.12); max-height:240px; overflow-y:auto;"></div>
      </div>
      <input type="hidden" id="search_areas" name="search_areas" value="<%= form.search_areas || '' %>">
      <p class="note" id="cityNote">Pick each city from the list — it's added as a tag, and you can click × to remove it.</p>
      <script>
      (function(){
        var CITIES = <%- JSON.stringify(H.UT_CITIES) %>;
        var tags = [];
        var hidden = document.getElementById('search_areas');
        var input = document.getElementById('city_input');
        var wrap = document.getElementById('cityTags');
        var box = document.getElementById('citySuggest');
        var note = document.getElementById('cityNote');
        var matches = [], active = -1;
        var byLower = {};
        CITIES.forEach(function(c){ byLower[c.toLowerCase()] = c; });
        // Keep only entries that are real cities (e.g. server re-render).
        (hidden.value || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean).forEach(function(c){
          var real = byLower[c.toLowerCase()];
          if (real && tags.indexOf(real) === -1) tags.push(real);
        });
        function render(){
          hidden.value = tags.join(', ');
          wrap.innerHTML = tags.map(function(c, i){
            return '<span class="pill" style="cursor:pointer;" data-i="' + i + '">' + c.replace(/</g,'&lt;') + ' ×</span>';
          }).join('');
          wrap.querySelectorAll('.pill').forEach(function(el){
            el.addEventListener('click', function(){ tags.splice(parseInt(el.dataset.i), 1); render(); });
          });
        }
        function close(){ box.style.display = 'none'; box.innerHTML = ''; matches = []; active = -1; input.setAttribute('aria-expanded', 'false'); }
        function addCity(name){
          if (tags.indexOf(name) === -1) tags.push(name);
          input.value = '';
          note.textContent = 'Pick each city from the list — it\'s added as a tag, and you can click × to remove it.';
          note.style.color = '';
          close();
          render();
        }
        function highlight(){
          box.querySelectorAll('.citychoice').forEach(function(el, i){
            el.style.background = i === active ? '#EAF2FF' : '';
            el.style.fontWeight = i === active ? '600' : '';
          });
        }
        function drawList(){
          box.innerHTML = matches.map(function(c){
            return '<div class="citychoice" role="option" data-city="' + c.replace(/"/g, '&quot;') + '" style="padding:10px 14px; cursor:pointer; font-size:15px;">' + c + '</div>';
          }).join('');
          box.style.display = matches.length ? 'block' : 'none';
          input.setAttribute('aria-expanded', matches.length ? 'true' : 'false');
          box.querySelectorAll('.citychoice').forEach(function(el, i){
            // mousedown (not click) so it fires before the input's blur hides the box
            el.addEventListener('mousedown', function(e){ e.preventDefault(); addCity(el.dataset.city); });
            el.addEventListener('click', function(e){ e.preventDefault(); addCity(el.dataset.city); }); // touch fallback
            el.addEventListener('mouseenter', function(){ active = i; highlight(); });
          });
          highlight();
        }
        function suggest(){
          var q = input.value.trim().toLowerCase();
          if (!q) { close(); return; }
          var starts = [], contains = [];
          for (var i = 0; i < CITIES.length; i++) {
            var lower = CITIES[i].toLowerCase();
            if (tags.indexOf(CITIES[i]) !== -1) continue; // already chosen
            if (lower.indexOf(q) === 0) starts.push(CITIES[i]);
            else if (lower.indexOf(q) !== -1) contains.push(CITIES[i]);
          }
          matches = starts.concat(contains).slice(0, 8);
          active = matches.length ? 0 : -1;
          drawList();
        }
        input.addEventListener('input', suggest);
        input.addEventListener('focus', suggest);
        input.addEventListener('blur', function(){ setTimeout(close, 150); });
        input.addEventListener('keydown', function(e){
          if (e.key === 'ArrowDown') { e.preventDefault(); if (matches.length) { active = (active + 1) % matches.length; highlight(); } }
          else if (e.key === 'ArrowUp') { e.preventDefault(); if (matches.length) { active = (active - 1 + matches.length) % matches.length; highlight(); } }
          else if (e.key === 'Escape') { close(); }
          else if (e.key === 'Enter' || e.key === ',') {
            e.preventDefault();
            var exact = byLower[input.value.trim().toLowerCase()];
            if (exact && tags.indexOf(exact) === -1) { addCity(exact); }
            else if (active >= 0 && matches[active]) { addCity(matches[active]); }
            else if (input.value.trim()) {
              note.textContent = "That doesn't match a Utah city — keep typing and pick one from the list.";
              note.style.color = '#B42318';
            }
          }
        });
        render();
        window.__cityTagsReady = true; // marker for automated tests
      })();
      </script>
      <label for="price_range">Price range</label>
      <select id="price_range" name="price_range" required>
        <option value="" disabled <%= !form.price_range ? 'selected' : '' %>>Choose one…</option>
        <% Object.keys(H.PRICE_RANGES).forEach(o => { %><option <%= form.price_range === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <label for="timeline">When do you want to buy?</label>
      <select id="timeline" name="timeline" required>
        <option value="" disabled <%= !form.timeline ? 'selected' : '' %>>Choose one…</option>
        <% H.B_TIMELINE.forEach(o => { %><option <%= form.timeline === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <label for="expected_tours">About how many homes do you anticipate touring before making a decision?</label>
      <select id="expected_tours" name="expected_tours">
        <option value="" <%= !form.expected_tours ? 'selected' : '' %>>Choose one…</option>
        <% H.B_EXPECTED_TOURS.forEach(o => { %><option <%= form.expected_tours === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <p class="note">We know plans can change — your best estimate helps professionals understand the time and service you may need.</p>
      <label for="purchase_purpose">This home will be a…</label>
      <select id="purchase_purpose" name="purchase_purpose">
        <% H.B_PURPOSE.forEach(o => { %><option <%= (form.purchase_purpose || 'Primary residence') === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Your current home</h2>
      <label for="current_situation">Right now you…</label>
      <select id="current_situation" name="current_situation">
        <% H.B_SITUATION.forEach(o => { %><option <%= (form.current_situation || 'Rent') === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <label for="need_to_sell">Do you need to sell a home before buying?</label>
      <select id="need_to_sell" name="need_to_sell">
        <% H.B_SELL_FIRST.forEach(o => { %><option <%= (form.need_to_sell || 'No') === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Where you're located</h2>
      <label>Are you currently in Utah?</label>
      <div class="optgrid cols">
        <label class="opt"><input type="radio" name="in_utah" value="yes" <%= form.in_utah !== 'no' ? 'checked' : '' %> onchange="document.getElementById('relo').style.display='none'"><span class="tile"><b>Yes</b></span></label>
        <label class="opt"><input type="radio" name="in_utah" value="no" <%= form.in_utah === 'no' ? 'checked' : '' %> onchange="document.getElementById('relo').style.display='block'"><span class="tile"><b>No — I'm relocating</b></span></label>
      </div>
      <div id="relo" style="display:<%= form.in_utah === 'no' ? 'block' : 'none' %>; margin-top:10px;">
        <label for="origin_state">Which state are you moving from?</label>
        <select id="origin_state" name="origin_state">
          <option value="" <%= !form.origin_state ? 'selected' : '' %>>Choose a state…</option>
          <% H.US_STATES.forEach(s => { %><option <%= form.origin_state === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
        <label for="move_reason">Reason for the move (optional)</label>
        <input type="text" id="move_reason" name="move_reason" placeholder="e.g. job, family, lifestyle" value="<%= form.move_reason || '' %>">
        <label for="visit_dates">When do you plan to visit Utah? (optional)</label>
        <input type="text" id="visit_dates" name="visit_dates" placeholder="e.g. Sept 12–15" value="<%= form.visit_dates || '' %>">
      </div>
      <%# Separate question (Paul, Sep 1 UX #4): virtual tours are independent
          of the Utah/relocating answer — a buyer can be relocating AND want
          video tours. Never part of the same mutually-exclusive choice. %>
      <label style="margin-top:14px;">Would video/virtual tours be helpful?</label>
      <div class="optgrid">
        <label class="opt"><input type="checkbox" name="video_tours" value="yes" <%= form.video_tours === 'yes' ? 'checked' : '' %>><span class="tile"><b style="font-weight:600;">Yes, I'd like this option</b><span class="desc">Helpful if you're relocating, traveling, or just prefer a first look on video.</span></span></label>
      </div>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">Choose your proposal window</h2>
      <p class="note" style="margin-top:2px;">Verified buyer's agents compete during this window. Proposals stay sealed until it closes — then you compare everything at once. If all 10 spots fill early, it closes right then and your comparison is ready sooner.</p>
      <div class="optgrid">
        <% H.WINDOWS.forEach(w => { %>
          <label class="opt">
            <input type="radio" name="window_hours" value="<%= w.hours %>" <%= (parseInt(form.window_hours) || 48) === w.hours ? 'checked' : '' %>>
            <span class="tile"><span>
              <% if (w.hours === 48) { %><span class="rec">RECOMMENDED</span><% } %>
              <b><%= w.label %></b>
              <span class="desc"><%= w.desc %></span>
            </span></span>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="card">
      <h2 style="font-size:16px;">One important question</h2>
      <label for="bba">Have you signed a Buyer Broker Agreement with another agent?</label>
      <select id="bba" name="bba" onchange="var on=this.value==='Yes — currently active'; document.getElementById('bbaExpiresWrap').style.display=on?'block':'none';">
        <% H.B_BBA.forEach(o => { %><option <%= (form.bba || 'No') === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
      <%# Conditional (Paul, Sep 1 UX #3): the expiration question only
          appears when an agreement currently exists. %>
      <div id="bbaExpiresWrap" style="display:<%= (form.bba === 'Yes — currently active') ? 'block' : 'none' %>;">
        <label for="bba_expires">When does it expire? (optional)</label>
        <input type="text" id="bba_expires" name="bba_expires" placeholder="e.g. October 2026" value="<%= form.bba_expires || '' %>">
      </div>
      <p class="note">An active exclusive agreement means that agent already represents you — we'll explain what that means on the next screen if it applies.</p>
    </div>

    <button class="btn full" type="submit" style="margin-top:6px;">Publish my buyer profile</button>
    <p class="note" style="text-align:center;">Free · anonymous until you connect · no obligation</p>
  </form>
</div>
<%- include('../partials/foot') %>
