<%- include('../partials/head') %>
<a href="/dashboard" style="font-size:14px;">‹ Back to my dashboard</a>
<h1 style="margin-top:8px;">My buyer profile <span class="badge <%= profile.readiness === 'ready_now' ? 'connected' : profile.readiness === 'preparing' ? 'open' : 'pending' %>" style="vertical-align:4px;"><%= H.READINESS_LABELS[profile.readiness] %></span></h1>
<p class="sub"><%= profile.search_areas %> · <%= profile.price_range %> · <%= profile.timeline %><% if (!profile.in_utah) { %> · Relocating from <%= profile.origin_state %><% } %></p>

<% if (typeof existingNote !== 'undefined' && existingNote) { %>
  <div class="card" style="border-left:4px solid var(--blue); margin-bottom:14px;">
    <p class="sub" style="margin:0;">You already have an open buying request — it's shown below. To keep agent proposals in one place (and avoid duplicate notifications), each account runs one open buying request at a time. As soon as you connect with an agent — or this request expires or is withdrawn — you can start a new one. Want different cities or a different price range right now? Update this request instead.</p>
  </div>
<% } %>

<% const connectedProposal = proposals.find(p => p.connected); %>

<% if (profile.status === 'connected' && connectedProposal) { %>
  <div class="narrow" style="max-width:640px; margin:0;">
    <h2>You're connected 🎉</h2>
    <p class="sub"><%= connectedProposal.agent_name %> has received your contact information and will reach out soon. You can also reach them directly:</p>
    <div class="card">
      <div class="sumrow"><span>Professional</span><span><%= connectedProposal.agent_name %></span></div>
      <div class="sumrow"><span>Brokerage</span><span><%= connectedProposal.brokerage %></span></div>
      <div class="sumrow"><span>License</span><span><%= connectedProposal.license_number %></span></div>
      <div class="sumrow"><span>Email</span><span><%= connectedProposal.agent_email %></span></div>
      <% if (connectedProposal.agent_phone) { %><div class="sumrow"><span>Phone</span><span><%= connectedProposal.agent_phone %></span></div><% } %>
      <div class="sumrow"><span>Their proposal</span><span><%= H.buyerFeeLabel(connectedProposal) %></span></div>
    </div>
    <div class="success">The buyer representation agreement is signed directly with their brokerage, outside Connexli. Still no obligation.</div>
    <% if (feedbackGiven) { %>
      <div class="checkrow" style="margin-top:14px;"><span class="c">✓</span><span><b>Feedback received — thank you.</b> Your answers help us keep Connexli honest.</span></div>
    <% } else { %>
      <div class="card" style="border-left:4px solid var(--blue); margin-top:14px;">
        <h2 style="font-size:16px;">How did it go?</h2>
        <p class="sub" style="margin-bottom:10px;">Two minutes, five questions — tell us how the connection with <%= connectedProposal.agent_name %> went. Your answers go to Connexli only.</p>
        <a class="btn" href="/feedback/buyer/<%= profile.id %>">Give feedback</a>
      </div>
    <% } %>
  </div>
<% } else if (profile.status === 'expired') { %>
  <div class="card"><p class="sub">Your profile expired after 30 days. Renew it to go back in front of agents.</p>
    <form method="POST" action="/buyer/renew"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn" type="submit">Renew for 30 more days</button></form>
  </div>
<% } else if (!profile.published) { %>
  <div class="card" style="border-left:4px solid var(--blue);">
    <h2 style="font-size:16px;">Your profile isn't in front of agents yet</h2>
    <p class="sub" style="margin-bottom:10px;">You're in the <b>Exploring</b> stage. Agents compete hardest for prepared buyers — our Get Ready guide shows the fastest path, and the moment you're preapproved, one tap publishes your profile.</p>
    <a class="btn" href="/buyer/get-ready">Get ready to buy</a>
  </div>
<% } else if (scheduled) { %>
  <%# Overnight submission (Paul, Sep 2 §6): saved, opens at 7:00 AM Mountain. %>
  <div class="success">✓ <b>Your request is ready.</b> To give professionals a fair opportunity to respond, requests submitted overnight begin accepting proposals at 7:00 AM Mountain Time. Eligible professionals will be notified then.</div>
<% } else { %>
  <div class="checkrow"><span class="c">🔒</span><span>Your profile is live and anonymous. Agents see your search, never your name — sealed proposals reveal together when your window closes, and competing agents never see each other's terms.</span></div>
<% } %>

<% if (profile.status === 'active' && profile.published && windowIsOpen) { %>
  <div class="card" style="text-align:center; margin-top:14px;">
    <div style="font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.7px;"><%= scheduled ? 'Opens for proposals in' : 'Proposal window closes in' %></div>
    <div class="count" id="clock" data-closes="<%= new Date(scheduled ? profile.live_at : profile.closes_at).toISOString() %>">…</div>
    <div class="bar"><i id="clockbar" style="width:0%"></i></div>
    <% if (scheduled) { %>
      <p style="margin-top:12px; font-size:15px;">Proposal window: <b><%= liveAtText %></b> until <b><%= new Date(profile.closes_at).toLocaleString('en-US', { timeZone: 'America/Denver', weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %> Mountain Time</b></p>
      <p class="note" style="margin-top:4px;">Your full <%= profile.window_hours >= 24 ? (profile.window_hours / 24) + '-day' : profile.window_hours + '-hour' %> window starts when it opens — none of the overnight wait counts against it. This page updates itself.</p>
    <% } else { %>
    <p style="margin-top:12px; font-size:15px;"><b style="color:var(--blue); font-size:19px;"><%= profile.proposal_count %></b> of <b><%= profile.proposal_cap %></b> sealed proposals received</p>
    <p class="note" style="margin-top:4px;">If all 10 spots for this round fill before the countdown ends, the window closes early and your comparison is ready sooner.</p>
    <% } %>
    <div class="sealed">🔒 <span><b>Why sealed?</b> Agents can't see each other's offers, so each one gives you their best proposal, not the minimum needed to beat a rival. You'll see everything the moment the window closes.</span></div>
  </div>
  <script>
  (function(){
    var el = document.getElementById('clock');
    var closes = new Date(el.dataset.closes).getTime();
    var total = <%= scheduled ? Math.max(1, new Date(profile.live_at).getTime() - new Date(profile.created_at).getTime()) : profile.window_hours * 3600 * 1000 %>;
    function tick(){
      var left = closes - Date.now();
      if (left <= 0) { location.reload(); return; }
      var h = Math.floor(left/3600000), m = Math.floor(left%3600000/60000), s = Math.floor(left%60000/1000);
      el.textContent = String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
      document.getElementById('clockbar').style.width = Math.min(100, Math.round(100*(1-left/total)))+'%';
    }
    tick(); setInterval(tick, 1000);
    setInterval(function(){ location.reload(); }, 120000);
  })();
  </script>
<% } %>

<% if (profile.status === 'active' && profile.published && !windowIsOpen && !connectedProposal && !profile.extended && profile.proposal_count < profile.proposal_cap) { %>
  <div class="card" style="border-left:4px solid var(--blue); margin-top:14px;">
    <h2 style="font-size:16px;">Your window ended with <%= profile.proposal_count %> proposal<%= profile.proposal_count === 1 ? '' : 's' %> — want to keep it open?</h2>
    <p class="sub" style="margin-bottom:10px;">Keep this same request open for an additional <b>24 hours</b> — agents who already proposed stay in, and new ones can still join until the extension ends or all <%= profile.proposal_cap %> spots fill. Available once per request.</p>
    <form method="POST" action="/buyer/extend">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn" type="submit">Keep request open for 24 more hours</button>
    </form>
  </div>
<% } %>

<% if (profile.status === 'active' && profile.published && !windowIsOpen && !connectedProposal) { %>
  <% const roundFull = profile.proposal_count >= profile.proposal_cap; %>
  <div class="card" style="border-left:4px solid var(--blue); margin-top:14px;">
    <h2 style="font-size:16px;">Want more options?</h2>
    <p class="sub" style="margin-bottom:10px;">Receive <b>10 more proposals</b>: your request goes live again for <%= profile.window_hours >= 24 ? (profile.window_hours / 24) + ' day' + (profile.window_hours > 24 ? 's' : '') : profile.window_hours + ' hours' %>, and only verified agents who <b>haven't</b> proposed yet will see it. Every proposal you already have stays right here. This continues until you choose an agent — only then is your contact information released.</p>
    <% if (roundFull) { %>
      <form method="POST" action="/buyer/rebid" onsubmit="return confirm('Receive 10 more proposals? Your window reopens for additional agents (who haven\'t proposed yet), and your current proposals remain saved.');">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn ghost" type="submit">Receive 10 more proposals</button>
      </form>
    <% } else { %>
      <button class="btn ghost" type="button" disabled style="opacity:.45; cursor:not-allowed;">Receive 10 more proposals</button>
      <p class="note" style="margin-top:8px;">Another round becomes available after all <%= profile.proposal_cap %> proposal spots have been filled.<% if (!profile.extended) { %> Until then, the 24-hour extension above gives more agents time to propose.<% } %></p>
    <% } %>
  </div>
<% } %>

<% if (profile.status === 'active' && !windowIsOpen) { %>
  <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-top:24px;">
    <h2 style="margin:0;">Proposals (<%= proposals.length %><% if (profile.round > 1) { %> across <%= profile.round %> rounds<% } %>)</h2>
    <% if (proposals.length >= 2) { %><a class="btn ghost sm" href="/buyer/requests/<%= profile.id %>/compare">Compare side by side</a><% } %>
  </div>
  <p class="note">ⓘ Each amount shown is that professional's <b>proposed buyer-agent compensation</b>. Sellers often contribute toward it — but if the seller does not cover the full amount you agree to with your agent, <b>you may be responsible for the remaining balance at closing</b>, depending on your written agreement. Each proposal states that agent's answer below. Review your agreement's terms before signing anything. Connexli does not set or recommend commissions.</p>
  <% if (proposals.length === 0) { %>
    <div class="card"><p class="sub">No proposals yet. Verified agents in your areas have been notified — most buyers hear back within a day or two. Proposals appear here the moment they arrive.</p></div>
  <% } else { %>
    <div class="cards">
      <% proposals.forEach(p => { %>
        <div class="card pcard">
          <div class="grow">
            <div class="agent-top">
              <div class="avatar"><%= p.agent_name.split(' ').map(w => w[0]).join('').slice(0,2).toUpperCase() %></div>
              <div><b><%= p.agent_name %></b><span class="brok"><%= p.brokerage %> · <span style="color:var(--good); font-weight:600;">✓ Verified</span></span></div>
            </div>
            <% if (p.transactions_seller_12mo !== null || p.transactions_buyer_12mo !== null) { %>
              <p class="note" style="margin-top:6px;"><b>Last 12 months:</b> <%= p.transactions_buyer_12mo ?? 0 %> buyer-side · <%= p.transactions_seller_12mo ?? 0 %> seller-side transactions <span style="color:var(--muted);">(reported by the professional)</span></p>
            <% } %>
            <div class="complbl">Proposed buyer-agent compensation ⓘ</div>
            <div><span class="fee"><%= H.buyerFeeLabel(p) %></span>
              <% const est = H.estBuyerFee(p, profile.price_range); %>
              <% if (est !== null) { %><span class="est">Est. compensation: ≈ <%= H.money(est) %><% if (p.comp_structure === 'pct') { %> at your range midpoint (<%= H.money(H.midPrice(profile.price_range)) %>)<% } %></span><% } %>
            </div>
            <%# Shortfall policy in plain English with a worked example at the
                buyer's range midpoint (Paul, Sep 1 UX #2). Legacy proposals
                map from the old yes/no answer. These are proposal terms, not
                the representation contract. %>
            <% const sfp = p.shortfall_policy || (p.gap_responsibility === 'No' ? (p.min_fee ? 'min_fee' : 'no_gap') : (p.gap_responsibility === 'Yes' ? 'buyer_pays' : null)); %>
            <% const sfEst = H.estBuyerFee(p, profile.price_range); %>
            <% if (sfp === 'buyer_pays') { %>
              <p class="note"><b>If the seller pays less than the proposed fee:</b> any seller-paid compensation is credited toward the fee, and you would be responsible for the remaining amount.<% if (sfEst !== null) { %> <span style="color:var(--muted);">Example at your range midpoint: proposed fee ≈ <%= H.money(sfEst) %> — if the seller contributed <%= H.money(Math.round(sfEst / 2)) %>, you would cover the remaining <%= H.money(sfEst - Math.round(sfEst / 2)) %>.</span><% } %></p>
            <% } else if (sfp === 'min_fee' && p.min_fee) { %>
              <p class="note"><b>If the seller pays less than the proposed fee:</b> this professional accepts the seller-paid amount as long as their minimum compensation of <b><%= H.money(p.min_fee) %></b> is met — you'd only ever pay what it takes to reach that minimum, not the full difference.<% if (sfEst !== null) { %> <span style="color:var(--muted);">Example at your range midpoint: proposed fee ≈ <%= H.money(sfEst) %>, but if the seller contributed nothing you would owe at most <%= H.money(p.min_fee) %>.</span><% } %></p>
            <% } else if (sfp === 'no_gap') { %>
              <p class="note"><b>If the seller doesn't cover the full amount:</b> this agent will not ask you to pay the difference.</p>
            <% } %>
            <div class="pillrow">
              <% if (p.video_tours) { %><span class="pill">Video tours</span><% } %>
              <% if (p.response_time) { %><span class="pill">Responds: <%= p.response_time.toLowerCase() %></span><% } %>
              <% (p.specialties ? p.specialties.split(', ') : []).forEach(s => { %><span class="pill"><%= s %></span><% }) %>
            </div>
            <% if (p.seller_contribution) { %><p class="note" style="margin-top:9px;"><b>Seller contributions:</b> <%= p.seller_contribution %></p><% } %>
            <% if (p.plan) { %><p class="note"><b>Their plan for you:</b> <%= p.plan %></p><% } %>
          </div>
          <div class="cardbtns">
            <form method="POST" action="/buyer/connect/<%= p.id %>" onsubmit="return confirm('Release your name, email, and phone number to <%= p.agent_name %>? Only this professional receives your details.\n\nNote: selecting an agent may lead to a separate written representation agreement — review the compensation terms in that agreement before signing.');">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn" type="submit">Connect</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
    <p class="note">Connecting releases your contact info to that one professional only. The buyer representation agreement is signed with their brokerage, outside Connexli. No obligation.</p>
  <% } %>
<% } %>

<% if (profile.status === 'active') { %>
  <div class="card" style="margin-top:20px;">
    <h2 style="font-size:16px;">Manage my profile</h2>
    <p class="sub" style="margin-bottom:10px;">Active until <%= new Date(profile.expires_at).toLocaleDateString('en-US') %>. <% if (!profile.priorities && !profile.property_prefs) { %>Complete profiles get stronger, more specific proposals.<% } %></p>
    <div class="actions">
      <a class="btn ghost sm" href="/buyer/boost"><%= (profile.priorities || profile.property_prefs) ? 'Edit my preferences' : 'Boost my profile' %></a>
      <form method="POST" action="/buyer/renew"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm" type="submit">Renew 30 days</button></form>
      <form method="POST" action="/buyer/withdraw" onsubmit="return confirm('Withdraw your buyer profile? Agents will no longer see it.');"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm" type="submit">Withdraw</button></form>
    </div>
  </div>
<% } %>
<%- include('../partials/foot') %>
