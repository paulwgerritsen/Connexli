<%- include('partials/head') %>
<div class="narrow">
  <h1>Create your account</h1>
  <p class="sub">Free for homeowners. Professionals are verified before they can submit proposals.</p>
  <div class="checkrow"><span class="c">✓</span><span>Your address and contact info are hidden until you choose to share them.</span></div>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <div class="card">
    <form method="POST" action="/register">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>I am a…</label>
      <div class="optgrid cols">
        <label class="opt">
          <input type="radio" name="role" value="seller" <%= form.role !== 'agent' ? 'checked' : '' %> onchange="toggleAgent()">
          <span class="tile"><span><b>Homeowner / Buyer</b><span class="desc">I'm selling, buying, or both — let professionals compete for my business.</span></span></span>
        </label>
        <label class="opt">
          <input type="radio" name="role" value="agent" <%= form.role === 'agent' ? 'checked' : '' %> onchange="toggleAgent()">
          <span class="tile"><span><b>Real estate professional</b><span class="desc">I want to win new clients on Connexli.</span></span></span>
        </label>
      </div>

      <div class="grid2">
        <div>
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" value="<%= form.name || '' %>" autocomplete="name" required>
        </div>
        <div>
          <label for="phone">Phone <span class="hint">(shared only when you connect)</span></label>
          <input type="text" id="phone" name="phone" value="<%= form.phone || '' %>" autocomplete="tel">
        </div>
      </div>
      <div class="grid2">
        <div>
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" value="<%= form.email || '' %>" autocomplete="email" required>
        </div>
        <div>
          <label for="password">Password <span class="hint">(8+ characters)</span></label>
          <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required>
        </div>
      </div>

      <div id="agentFields" style="display:none;">
        <div class="grid2">
          <div>
            <label for="license_state">License state</label>
            <select id="license_state" name="license_state">
              <% H.LICENSE_STATES.forEach(s => { %><option value="<%= s[0] %>" <%= (form.license_state || 'UT') === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %>
            </select>
          </div>
          <div>
            <label for="license_number">Real estate license number</label>
            <input type="text" id="license_number" name="license_number" value="<%= form.license_number || '' %>" placeholder="e.g. 9876543-SA00">
          </div>
        </div>
        <label for="brokerage">Brokerage</label>
        <input type="text" id="brokerage" name="brokerage" value="<%= form.brokerage || '' %>">
        <label for="service_zip">Primary service ZIP code <span class="hint">(the center of the area you serve)</span></label>
        <input type="text" id="service_zip" name="service_zip" inputmode="numeric" pattern="\d{5}" value="<%= form.service_zip || '' %>" placeholder="e.g. 84025">
        <p class="note">We'll email you when homeowners near this area invite proposals. You can still browse every open opportunity statewide.</p>
        <p class="note">Utah pilot: your license is checked against the Utah Division of Real Estate registry before your account is activated. By registering you confirm your brokerage authorizes you to offer pricing and services on Connexli.</p>
      </div>

      <button class="btn full" type="submit" style="margin-top:18px;">Create account</button>
      <p class="note" style="text-align:center;">By creating an account you agree to the <a href="https://connexli.com/terms.html" target="_blank" rel="noopener">Terms of Service</a> and <a href="https://connexli.com/privacy.html" target="_blank" rel="noopener">Privacy Policy</a>.</p>
    </form>
  </div>
  <p class="note">Already have an account? <a href="/login">Log in</a>.</p>
</div>
<script>
function toggleAgent(){
  var isAgent = document.querySelector('input[name="role"][value="agent"]').checked;
  document.getElementById('agentFields').style.display = isAgent ? 'block' : 'none';
  document.getElementById('license_number').required = isAgent;
  document.getElementById('brokerage').required = isAgent;
  document.getElementById('service_zip').required = isAgent;
}
toggleAgent();
</script>
<%- include('partials/foot') %>
