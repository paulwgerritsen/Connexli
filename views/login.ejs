<%- include('partials/head') %>
<div class="narrow">
  <h1>Welcome back</h1>
  <p class="sub">Log in to your Connexli account.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (notice) { %><div class="notice" style="background:#EAF7EE; border:1px solid #BFE5CB; color:#1E6B37; border-radius:10px; padding:12px 16px; margin-bottom:16px; font-size:14.5px;"><%= notice %></div><% } %>
  <div class="card">
    <form method="POST" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" value="<%= email %>" autocomplete="email" required>
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
      <button class="btn full" type="submit" style="margin-top:18px;">Log in</button>
    </form>
  </div>
  <p class="note">New to Connexli? <a href="/register">Create an account</a>. · <a href="/forgot">Forgot password?</a></p>
</div>
<%- include('partials/foot') %>
