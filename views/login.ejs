<%- include('partials/head') %>
<div class="narrow">
  <h1>Welcome back</h1>
  <p class="sub">Log in to your Connexli account.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <div class="card">
    <form method="POST" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" value="<%= email %>" autocomplete="email" required>
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
      <button class="btn full" type="submit" style="margin-top:18px;">Log in</button>
    </form>
  </div>
  <p class="note">New to Connexli? <a href="/register">Create an account</a>.</p>
</div>
<%- include('partials/foot') %>
