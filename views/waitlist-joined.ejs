<%- include('partials/head') %>
<div class="narrow" style="max-width:640px;">
  <% if (joined) { %>
    <div class="card" style="text-align:center; padding:42px 24px; margin-top:18px;">
      <div style="font-size:46px;">🎉</div>
      <h1 style="margin-top:10px;">You're on the list!</h1>
      <p class="sub">We'll let you know when Connexli launches in your state.</p>
      <p style="margin-top:18px;"><a class="btn ghost" href="https://connexli.com">Back to connexli.com</a></p>
    </div>
  <% } else { %>
    <h1 style="margin-top:8px;">Not in Utah? Be first in your state</h1>
    <p class="sub">Connexli is live across Utah today. Join the waitlist and we'll email you the moment we launch in your state.</p>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="/waitlist">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div style="position:absolute; left:-9999px;" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
      </div>
      <div class="card">
        <label for="role">I am a…</label>
        <select id="role" name="role" required>
          <option value="" disabled <%= !form.user_type ? 'selected' : '' %>>Choose one</option>
          <% types.forEach(t => { %><option value="<%= t %>" <%= form.user_type === t ? 'selected' : '' %>><%= t %></option><% }) %>
        </select>
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" value="<%= form.email || '' %>" autocomplete="email" required>
        <label for="state">Your state</label>
        <select id="state" name="state" required>
          <option value="" disabled <%= !form.state ? 'selected' : '' %>>Choose your state…</option>
          <% H.US_STATES.forEach(s => { %><option <%= form.state === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </div>
      <button class="btn full" type="submit">Join the waitlist</button>
      <p class="note" style="text-align:center;">We'll only email you about Connexli. No spam, unsubscribe anytime.</p>
    </form>
  <% } %>
</div>
<%- include('partials/foot') %>
