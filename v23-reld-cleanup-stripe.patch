+<p class="note">Net = gross − refunds − processor fees. Fees appear once Stripe reports them for each charge (usually seconds after payment); an order whose fee hasn't arrived yet shows "—" and is counted at $0 fee until it does.</p>
+
+<% if (flagged.length) { %>
+<div class="card" style="border-color:#F0B429;">
+  <h2 style="font-size:16px; color:#B45309;">⚠ Refunds needing review · <%= flagged.length %></h2>
+  <p class="note" style="margin-top:2px;">A refund came in but the professional had already used some (or all) of the credits it paid for, so the platform reversed what it could and stopped — it never takes a balance below zero. Decide whether to leave it, record an admin debit on the professional's page, or contact them; then clear the flag.</p>
+  <div class="tblwrap">
+    <table class="dt">
+      <tr><th>Order</th><th>Professional</th><th>Flag</th><th>Note</th><th></th></tr>
+      <% flagged.forEach(f => { %>
+        <tr data-flagged-order="<%= f.id %>">
+          <td>#<%= f.id %></td>
+          <td><%= f.name %><br><span class="meta"><%= f.email %></span></td>
+          <td><%= f.review_flag %></td>
+          <td class="meta"><%= f.review_note || '' %></td>
+          <td><form method="POST" action="/admin/payments/<%= f.id %>/clear-flag" onsubmit="return confirm('Clear the review flag on order #<%= f.id %>? This only removes the warning; it does not change any balance.');">
+            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" type="submit">Mark reviewed</button></form></td>
+        </tr>
+      <% }) %>
+    </table>
+  </div>
+</div>
+<% } %>
+
+<div class="card">
+  <h2 style="font-size:16px;">Revenue by billing state</h2>
+  <p class="note" style="margin-top:2px;">Billing state is the address the professional entered at checkout (what a sales-tax filing would use). The CSV also carries each professional's service state and license state at the time of purchase.</p>
+  <% if (!byState.length) { %><p class="note">No purchases yet.</p><% } else { %>
+  <div class="tblwrap">
+    <table class="dt" id="by-state">
+      <tr><th>State</th><th>Purchases</th><th>Credits</th><th>Gross</th><th>Refunds</th><th>Net</th></tr>
+      <% byState.forEach(r => { %>
+        <tr><td><%= r.state %></td><td><%= r.purchases %></td><td><%= r.credits %></td><td><%= usd(r.gross) %></td><td><%= usd(r.refunds) %></td><td><%= usd(r.net) %></td></tr>
+      <% }) %>
+    </table>
+  </div>
+  <% } %>
+</div>
+
+<div class="card">
+  <h2 style="font-size:16px;">Revenue by month</h2>
+  <% if (!byMonth.length) { %><p class="note">No purchases yet.</p><% } else { %>
+  <div class="tblwrap">
+    <table class="dt" id="by-month">
+      <tr><th>Month</th><th>Purchases</th><th>Credits</th><th>Gross</th><th>Refunds</th><th>Net</th></tr>
+      <% byMonth.forEach(r => { %>
+        <tr><td><%= r.month || '—' %></td><td><%= r.purchases %></td><td><%= r.credits %></td><td><%= usd(r.gross) %></td><td><%= usd(r.refunds) %></td><td><%= usd(r.net) %></td></tr>
+      <% }) %>
+    </table>
+  </div>
+  <% } %>
+</div>
+
+<div class="card">
+  <h2 style="font-size:16px;">Transactions<%= orders.length === 200 ? ' (latest 200 — the CSV has everything)' : ' · ' + orders.length %></h2>
+  <% if (!orders.length) { %><p class="note">No purchases yet.</p><% } else { %>
+  <div class="tblwrap">
+    <table class="dt" id="transactions">
+      <tr><th>Date (Mountain)</th><th>Professional</th><th>State</th><th>Package</th><th>Credits</th><th>Gross</th><th>Fee</th><th>Refund</th><th>Net</th><th>Status</th><th>Stripe ref</th></tr>
+      <% orders.forEach(o => { %>
+        <tr data-order-id="<%= o.id %>">
+          <td><%= o.paid_at ? new Date(o.paid_at).toLocaleString('en-US', { timeZone: 'America/Denver' }) : new Date(o.created_at).toLocaleString('en-US', { timeZone: 'America/Denver' }) %></td>
+          <td><a href="/admin/agents/<%= o.agent_id %>#payment-history"><%= o.name %></a><br><span class="meta"><%= o.email %></span></td>
+          <td><%= o.billing_state || '—' %><br><span class="meta">serves <%= o.service_state || o.current_license_state || '—' %></span></td>
+          <td><%= pkgLabel(o.package_key) %></td>
+          <td><%= o.credits %></td>
+          <td><%= usd(o.amount_cents) %></td>
+          <td><%= o.fee_cents == null ? '—' : usd(o.fee_cents) %></td>
+          <td><%= o.refunded_cents > 0 ? usd(o.refunded_cents) : '—' %></td>
+          <td><%= usd(o.net_after_fee_cents) %></td>
+          <td><%= o.status.replace(/_/g, ' ') %><%= o.review_flag ? ' ⚠' : '' %></td>
